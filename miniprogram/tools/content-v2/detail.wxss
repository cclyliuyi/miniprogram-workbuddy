page { height:100%; overflow:hidden; background:#f6f1e7; }
.learning-detail { height:100vh; display:flex; flex-direction:column; }
.reading-bar { padding:18rpx 30rpx; display:flex; justify-content:space-between; align-items:center; color:#6c776c; font-size:25rpx; background:#f6f1e7; flex-shrink:0; }
.lesson-swiper { flex:1; height:0; min-height:0; width:100%; }
.lesson-scroll { height:100%; }
.illustration-wrap { position:relative; min-height:1000rpx; background:#f6f1e7; }
.lesson-illustration { width:100%; display:block; }
.image-status { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24rpx; color:#746a5d; font-size:30rpx; background:#f6f1e7; }
.retry-image { font-size:29rpx; background:#e7e0d3; color:#173c4a; border-radius:12rpx; }
.image-caption { text-align:center; font-size:24rpx; color:#8b8171; margin:12rpx 0 24rpx; }
.lesson-body { margin:0 26rpx 32rpx; padding:38rpx 30rpx 20rpx; border-radius:22rpx; background:#fffcf6; }
.question { color:#15354b; font-size:38rpx; font-weight:600; line-height:1.65; margin-bottom:36rpx; }
.text-section { margin-bottom:32rpx; }
.section-label { font-size:26rpx; color:#947150; font-weight:600; margin-bottom:14rpx; }
.section-text { display:block; font-size:32rpx; line-height:1.9; color:#393c37; }
.boundary-section { border-top:1rpx solid #e9e1d4; padding-top:28rpx; margin:32rpx 0; }
.exercise-section { background:#edf2eb; border-radius:16rpx; padding:28rpx 24rpx; margin:32rpx -6rpx; }
.exercise-section .section-label { color:#4e7664; }
.formula-section { padding:24rpx; background:#f3eee5; border-radius:12rpx; margin-bottom:32rpx; }
.formula-text { display:block; font-size:34rpx; color:#16374b; line-height:1.8; overflow-wrap:anywhere; }
.formula-note { font-size:27rpx; line-height:1.8; color:#6f675d; margin-top:14rpx; }
.sources-section { margin-top:32rpx; }
.source-link { font-size:26rpx; line-height:1.75; color:#486d73; padding:20rpx 0; border-bottom:1rpx solid #eee7dc; }
.source-action { display:block; font-size:24rpx; color:#98876f; margin-top:6rpx; }
.reading-hint { text-align:center; margin:36rpx 0 16rpx; font-size:25rpx; color:#958b7b; }
.reading-nav { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); background:#f6f1e7; border-top:1rpx solid #e5dccd; }
.nav-button { margin:0; width:230rpx; flex-shrink:0; padding:8rpx 20rpx; font-size:29rpx; line-height:1.9; background:transparent; color:#265761; }
.nav-button::after { border:none; }
.nav-button[disabled] { color:#b9b1a5; background:transparent; }
.nav-progress { color:#8a7d6b; font-size:25rpx; white-space:nowrap; flex-shrink:0; }

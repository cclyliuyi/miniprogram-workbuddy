<view class="learning-list">
  <view class="series-header">
    <view class="series-eyebrow">{{total}} 个小主题 · 已读 {{readCount}}</view>
    <view class="series-title">{{title}}</view>
    <view class="series-intro">{{intro}}</view>
  </view>
  <view class="stage" wx:for="{{groups}}" wx:for-item="group" wx:key="title">
    <view class="stage-heading"><text class="stage-number">0{{group.number}}</text><text>{{group.title}}</text></view>
    <view class="stage-description">{{group.description}}</view>
    <view class="lesson-card" wx:for="{{group.cards}}" wx:key="id" bindtap="openCard" data-index="{{item.index}}" hover-class="lesson-pressed" role="button" aria-label="{{item.title}}，打开图解">
      <image class="lesson-thumbnail" src="{{item.imageSrc}}" mode="aspectFit" lazy-load="{{true}}" />
      <view class="lesson-summary">
        <view class="lesson-meta"><text>{{item.number < 10 ? '0' : ''}}{{item.number}}</text><text wx:if="{{item.isRead}}" class="read-label">已读</text></view>
        <view class="lesson-title">{{item.title}}</view>
        <view class="lesson-subtitle">{{item.subtitle}}</view>
        <view class="lesson-open">查看大图与详解 ›</view>
      </view>
    </view>
  </view>
  <view class="series-footer">每张图理解一个概念，每个练习连接实际问题。</view>
</view>

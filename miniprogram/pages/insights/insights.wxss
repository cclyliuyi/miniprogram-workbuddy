page { background: #f3efe6; }
.insights-page { padding: 42rpx 32rpx 130rpx; }

/* 头部 */
.insights-header { margin-bottom: 48rpx; }
.insights-eyebrow { font-size: 26rpx; color: #68786f; margin-bottom: 14rpx; }
.insights-title { font-size: 56rpx; font-weight: 600; color: #102d45; line-height: 1.3; }
.insights-intro { margin-top: 24rpx; color: #655f54; font-size: 30rpx; line-height: 1.8; }

/* 状态 */
.insights-state { padding: 120rpx 0; text-align: center; }
.state-emoji { font-size: 60rpx; color: #a36647; margin-bottom: 24rpx; }
.state-text { font-size: 28rpx; color: #857b6c; }
.state-spinner {
  width: 56rpx; height: 56rpx; margin: 0 auto 24rpx;
  border: 5rpx solid #e0d7c4; border-top-color: #a36647;
  border-radius: 50%; animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 文章卡片 */
.article-list { display: block; }
.article-card {
  background: #fcfaf5; border: 1rpx solid #e8e0d1; border-radius: 22rpx;
  margin-bottom: 26rpx; overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(90, 80, 50, 0.04);
}
.article-pressed { opacity: 0.78; transform: scale(0.992); }
.article-cover-wrap { position: relative; }
.article-cover { width: 100%; height: 320rpx; display: block; background: #f6f1e7; }
.featured-badge {
  position: absolute; top: 20rpx; right: 20rpx;
  background: rgba(163, 102, 71, 0.92); color: #fdf9f2;
  font-size: 22rpx; padding: 6rpx 20rpx; border-radius: 999rpx;
}
.article-body { padding: 30rpx 30rpx 28rpx; }
.article-kicker { display: flex; gap: 12rpx; align-items: baseline; font-size: 24rpx; color: #928676; }
.article-dot { color: #b8ac97; }
.article-title {
  color: #163249; font-size: 36rpx; font-weight: 600; line-height: 1.5;
  margin: 14rpx 0 12rpx; display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; overflow: hidden;
}
.article-summary {
  color: #6e675c; font-size: 27rpx; line-height: 1.7;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
}
.article-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.article-tag {
  font-size: 22rpx; color: #a36647; background: rgba(163, 102, 71, 0.09);
  border: 1rpx solid rgba(163, 102, 71, 0.22);
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.article-open { font-size: 25rpx; color: #a36647; margin-top: 22rpx; }

/* 尾部 */
.insights-footer {
  font-size: 26rpx; color: #857b6c; text-align: center;
  line-height: 1.8; padding: 20rpx 18rpx 12rpx;
}

/* subpackages/eit/pages/detail/detail.wxss —— 电磁信息论卡片详情（全屏浏览） */
page {
  background: #1a1814;
}

.eit-detail {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.eit-swiper {
  width: 100%;
  height: 100%;
}

.eit-page {
  position: relative;
  width: 100%;
  height: 100%;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

/* 背景图 */
.eit-bg {
  width: 100%;
  display: block;
}

/* 顶部渐变蒙版 */
.eit-top-mask {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 180rpx;
  background: linear-gradient(to bottom, rgba(26,24,20,.7), transparent);
  z-index: 1;
}

/* 卡片编号 */
.eit-page-num {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255,255,255,.7);
  z-index: 3;
  letter-spacing: 2rpx;
}

/* ═══ 文字信息层 ═══ */
.eit-info-panel {
  position: relative;
  margin: -80rpx 24rpx 40rpx;
  padding: 40rpx 36rpx;
  background: rgba(26, 24, 20, .82);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,.08);
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,.4);
  z-index: 2;
}
.eit-info-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
  margin-bottom: 10rpx;
}
.eit-info-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,.6);
  line-height: 1.5;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,.1);
}

/* 信息区块 */
.eit-info-section {
  margin-bottom: 28rpx;
}
.eit-info-label {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--sage, #8aab96);
  font-weight: 600;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}
.eit-info-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(255,255,255,.88);
}

/* 公式文本（fallback） */
.eit-info-formula {
  font-size: 28rpx;
  line-height: 1.6;
  color: #f5d99b;
  font-family: 'Courier New', monospace;
  background: rgba(245, 217, 155, .08);
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  border-left: 4rpx solid rgba(245, 217, 155, .4);
}

/* 公式渲染图容器 */
.eit-formula-box {
  background: rgba(245, 217, 155, .06);
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  border-left: 4rpx solid rgba(245, 217, 155, .4);
  display: flex;
  justify-content: center;
  align-items: center;
}
.eit-formula-img {
  max-width: 100%;
  max-height: 200rpx;
}

/* 一句话结论（引用块） */
.eit-info-quote {
  position: relative;
  margin: 32rpx 0;
  padding: 24rpx 24rpx 24rpx 48rpx;
  background: rgba(122, 145, 129, .12);
  border-radius: 16rpx;
  border-left: 4rpx solid var(--sage, #8aab96);
}
.eit-info-quote-mark {
  position: absolute;
  top: 8rpx;
  left: 16rpx;
  font-size: 56rpx;
  color: rgba(138, 171, 150, .3);
  font-family: Georgia, serif;
  line-height: 1;
}
.eit-info-quote-text {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
  color: rgba(255,255,255,.95);
}

/* 常见误区 */
.eit-info-warn {
  margin-bottom: 28rpx;
  padding: 20rpx 24rpx;
  background: rgba(176, 106, 79, .1);
  border-radius: 12rpx;
}
.eit-label-warn {
  color: rgba(200, 130, 100, .9);
}
.eit-text-warn {
  color: rgba(255, 200, 180, .85);
}

/* 标签 */
.eit-info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,.08);
}
.eit-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,.5);
  background: rgba(255,255,255,.06);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 点击提示 */
.eit-tap-hint {
  position: absolute;
  bottom: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 24rpx;
  color: rgba(255,255,255,.4);
  letter-spacing: 2rpx;
  z-index: 2;
  animation: tap-pulse 2s ease-in-out infinite;
}
@keyframes tap-pulse {
  0%, 100% { opacity: .3; }
  50% { opacity: .7; }
}

/* 底部渐变蒙版 */
.eit-bottom-mask {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 120rpx;
  background: linear-gradient(to top, rgba(26,24,20,.8), transparent);
  z-index: 1;
}

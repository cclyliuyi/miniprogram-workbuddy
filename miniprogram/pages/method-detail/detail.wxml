<view class="learning-detail">
  <view class="reading-bar"><text>{{cards[currentIndex].stage}}</text><text>{{currentIndex + 1}} / {{total}}</text></view>
  <swiper class="lesson-swiper" current="{{currentIndex}}" bindchange="onSwiperChange" duration="260">
    <swiper-item wx:for="{{cards}}" wx:key="id">
      <scroll-view class="lesson-scroll" scroll-y="{{true}}">
        <block wx:if="{{index >= currentIndex - 1 && index <= currentIndex + 1}}">
          <view class="illustration-wrap">
            <image class="lesson-illustration" src="{{item.imageSrc}}" mode="widthFix" data-index="{{index}}" bindload="onImageLoad" binderror="onImageError" bindtap="previewImage" aria-label="{{item.title}}图解，点击放大" />
            <view wx:if="{{item.imageStatus === 'loading'}}" class="image-status">图解加载中…</view>
            <view wx:if="{{item.imageStatus === 'error'}}" class="image-status"><text>图解暂未加载</text><button class="retry-image" data-index="{{index}}" bindtap="retryImage">重新加载</button></view>
          </view>
          <view class="image-caption">概念示意 · 点击图片可放大</view>
          <view class="lesson-body">
            <view class="question">{{item.coreQuestion}}</view>
            <view class="text-section" wx:for="{{item.sections}}" wx:for-item="section" wx:key="label">
              <view class="section-label">{{section.label}}</view>
              <text class="section-text" user-select="{{true}}">{{section.text}}</text>
            </view>
            <view class="formula-section" wx:if="{{item.keyFormula}}">
              <view class="section-label">用一个式子连接</view>
              <text class="formula-text" user-select="{{true}}">{{item.keyFormula}}</text>
              <view class="formula-note">{{item.formulaNote}}</view>
            </view>
            <view class="boundary-section"><view class="section-label">理解时留意</view><text class="section-text" user-select="{{true}}">{{item.misconception}}</text></view>
            <view class="exercise-section"><view class="section-label">{{item.exerciseLabel}}</view><text class="section-text" user-select="{{true}}">{{item.exercise}}</text></view>
            <view class="sources-section">
              <view class="section-label">延伸阅读</view>
              <view class="source-link" wx:for="{{item.sources}}" wx:for-item="source" wx:key="url" data-url="{{source.url}}" bindtap="copySource" role="button">{{source.label}}<text class="source-action">复制链接 ↗</text></view>
            </view>
            <view class="reading-hint">左右滑动，继续下一张图解</view>
          </view>
        </block>
      </scroll-view>
    </swiper-item>
  </swiper>
  <view class="reading-nav">
    <button class="nav-button" disabled="{{currentIndex === 0}}" data-step="-1" bindtap="navigateCard">‹ 上一张</button>
    <text class="nav-progress">{{currentIndex + 1}} / {{total}}</text>
    <button class="nav-button" disabled="{{currentIndex === total - 1}}" data-step="1" bindtap="navigateCard">下一张 ›</button>
  </view>
</view>

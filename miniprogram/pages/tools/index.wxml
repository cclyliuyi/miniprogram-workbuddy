<!-- pages/tools/index.wxml —— 常用工具首页 -->
<view class="screen tl">

  <!-- 标题区 -->
  <view class="tl-head rise">
    <view class="kicker">ENGINEERING TOOLS</view>
    <view class="tl-title display">常用工具</view>
    <view class="tl-sub">天线 · 雷达 · 通信 — 工程师口袋计算器</view>
  </view>

  <!-- 工具卡片网格 -->
  <view class="tl-grid">

    <!-- 专用计算 -->
    <view class="tl-card rise" bindtap="goCalc" style="animation-delay:.05s">
      <view class="tl-card-icon tl-icon-calc">
        <view class="tl-icon-inner">RF</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">专用计算</view>
        <view class="tl-card-desc">dBm↔W · 波长 · VSWR · 趋肤深度</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 天线阵列 -->
    <view class="tl-card rise" bindtap="goArray" style="animation-delay:.10s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">⬡</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">天线阵列</view>
        <view class="tl-card-desc">方向图 · 阵列因子 · 波束扫描</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 通信链路 -->
    <view class="tl-card rise" bindtap="goLink" style="animation-delay:.15s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">📶</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">通信链路</view>
        <view class="tl-card-desc">弗里斯方程 · 路径损耗 · 链路预算</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- Radar 链路 -->
    <view class="tl-card rise" bindtap="goRadar" style="animation-delay:.20s">
      <view class="tl-card-icon tl-icon-radar">
        <view class="tl-icon-inner">⊙</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">Radar 链路</view>
        <view class="tl-card-desc">雷达方程 · RCS · 多普勒频移</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 传输线 & 阻抗匹配 -->
    <view class="tl-card rise" bindtap="goMatch" style="animation-delay:.25s">
      <view class="tl-card-icon tl-icon-match">
        <view class="tl-icon-inner">Z₀</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">传输线 & 匹配</view>
        <view class="tl-card-desc">微带线 · λ/4 变换器 · L 型匹配 · 波导截止</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- Smith 圆图 -->
    <view class="tl-card rise" bindtap="goSmith" style="animation-delay:.30s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">◎</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">Smith 圆图</view>
        <view class="tl-card-desc">交互式阻抗图 · Γ/SWR/回波损耗 · 实时标点</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

  </view>

  <!-- ═══ 交互动画分区 ═══ -->
  <view class="tl-section-title">
    <view class="rule-dot"></view>
    <text class="tl-section-name">交互动画</text>
    <text class="tl-section-en">INTERACTIVE</text>
    <view class="rule-dot"></view>
  </view>

  <view class="tl-grid">

    <!-- 链路预算 -->
    <view class="tl-card rise" bindtap="goFriis" style="animation-delay:.05s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">📡</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">链路预算</view>
        <view class="tl-card-desc">Friis 单程 + 雷达双程 · Pr vs 距离曲线</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 阵列综合 -->
    <view class="tl-card rise" bindtap="goSynthesis" style="animation-delay:.10s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">⊞</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">阵列综合</view>
        <view class="tl-card-desc">均匀/余弦/汉明/切比雪夫加权 · 阵因子对比</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 阻抗圆图 -->
    <view class="tl-card rise" bindtap="goSmithChart" style="animation-delay:.15s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">◎</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">阻抗圆图</view>
        <view class="tl-card-desc">点击图面 · 实时求解 Γ / SWR / ZL</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 口径衍射 -->
    <view class="tl-card rise" bindtap="goAperture" style="animation-delay:.20s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">▭</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">口径衍射</view>
        <view class="tl-card-desc">矩形/圆形口径 · 照明分布 · 远场方向图</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 传输线驻波 -->
    <view class="tl-card rise" bindtap="goTransmissionLine" style="animation-delay:.25s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">∿</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">传输线驻波</view>
        <view class="tl-card-desc">V(z)/I(z) 分布 · Γ · SWR · 短路/开路/匹配</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 相控阵扫描 -->
    <view class="tl-card rise" bindtap="goPhasedArray" style="animation-delay:.30s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">⊟</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">相控阵扫描</view>
        <view class="tl-card-desc">波束指向 · 渐进相移 · 栅瓣检测</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 极化椭圆 -->
    <view class="tl-card rise" bindtap="goPolarization" style="animation-delay:.35s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">◯</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">极化椭圆</view>
        <view class="tl-card-desc">Ex/Ey 分量 · 线/圆/椭圆 · 行波传播</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 矩量法 -->
    <view class="tl-card rise" bindtap="goMomentMethod" style="animation-delay:.40s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">Z</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">矩量法</view>
        <view class="tl-card-desc">细线电流分布 · 阻抗矩阵热图 · 远场方向图</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 宽带匹配 -->
    <view class="tl-card rise" bindtap="goBroadbandMatching" style="animation-delay:.45s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">∿</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">宽带匹配</view>
        <view class="tl-card-desc">回波损耗曲线 · Smith 阻抗轨迹 · 带宽分析</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 电小天线 Chu 极限 -->
    <view class="tl-card rise" bindtap="goMiniaturization" style="animation-delay:.50s">
      <view class="tl-card-icon tl-icon-calc">
        <view class="tl-icon-inner">ka</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">电小天线</view>
        <view class="tl-card-desc">Chu Q 下界 · 辐射电阻 · 效率 · 近场储能</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 辐射积分 -->
    <view class="tl-card rise" bindtap="goRadiationIntegral" style="animation-delay:.55s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">∫</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">辐射积分</view>
        <view class="tl-card-desc">电流分布 → 积分路径 → 远场方向图</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 智能天线 -->
    <view class="tl-card rise" bindtap="goSmartArray" style="animation-delay:.60s">
      <view class="tl-card-icon tl-icon-radar">
        <view class="tl-icon-inner">∇</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">智能天线</view>
        <view class="tl-card-desc">MVDR 自适应零陷 · 目标增强 · 干扰抑制</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

  </view>

  <!-- ═══ 综合实验室分区 ═══ -->
  <view class="tl-section-title">
    <view class="rule-dot"></view>
    <text class="tl-section-name">综合实验室</text>
    <text class="tl-section-en">UNIFIED LABS</text>
    <view class="rule-dot"></view>
  </view>

  <view class="tl-grid">

    <!-- 电磁能流账本 -->
    <view class="tl-card rise" bindtap="goEnergyFlow" style="animation-delay:.05s">
      <view class="tl-card-icon tl-icon-calc">
        <view class="tl-icon-inner">∇·S</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">能流账本</view>
        <view class="tl-card-desc">端口分账 · Poynting 矢量 · Chu Q 极限</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 傅里叶空间 -->
    <view class="tl-card rise" bindtap="goFourierSpace" style="animation-delay:.10s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">F{·}</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">傅里叶空间</view>
        <view class="tl-card-desc">时频 · 口径 · 阵列 · 不确定性对偶</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 相位相干 -->
    <view class="tl-card rise" bindtap="goPhaseCoherence" style="animation-delay:.15s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">∠</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">相位相干</view>
        <view class="tl-card-desc">相量叠加 · 阵列扫描 · 等光程聚焦</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 边界模式 -->
    <view class="tl-card rise" bindtap="goBoundaryMode" style="animation-delay:.20s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">∂n</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">边界模式</view>
        <view class="tl-card-desc">边界条件 · 本征模式 · 格林函数 · 对称性</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 极化互易 -->
    <view class="tl-card rise" bindtap="goPolarReciprocity" style="animation-delay:.25s">
      <view class="tl-card-icon tl-icon-radar">
        <view class="tl-icon-inner">⇄</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">极化互易</view>
        <view class="tl-card-desc">极化椭圆 · 接收投影 · 收发互易</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

  </view>

  <!-- 底部说明 -->
  <view class="tl-foot">
    <view class="rule-dot"></view>
    <text class="tl-foot-text">所有公式基于 IEEE / 雷达手册标准，离线可用</text>
  </view>

</view>

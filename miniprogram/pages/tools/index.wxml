<!-- pages/tools/index.wxml —— 常用工具首页（数据驱动 v2） -->
<view class="screen tl">

  <!-- 标题区 -->
  <view class="tl-head rise">
    <view class="kicker">ENGINEERING TOOLS</view>
    <view class="tl-title display">常用工具</view>
    <view class="tl-sub">天线 · 雷达 · 通信 — 工程师口袋计算器</view>
  </view>

  <!-- 最近使用 -->
  <view class="tl-recent rise" wx:if="{{recent.length}}">
    <view class="tl-recent-head">
      <view class="kicker">最近使用</view>
      <view class="tl-recent-clear" bindtap="clearRecent">清空</view>
    </view>
    <scroll-view scroll-x class="tl-recent-scroll" enhanced show-scrollbar="{{false}}">
      <view class="tl-recent-row">
        <view
          wx:for="{{recent}}"
          wx:key="key"
          class="tl-recent-chip"
          data-url="{{item.url}}" data-key="{{item.key}}" data-name="{{item.name}}"
          data-icon="{{item.icon}}" data-cls="{{item.cls}}"
          bindtap="onCard">
          <view class="tl-recent-icon {{item.cls}}"><view class="tl-recent-icon-inner">{{item.icon}}</view></view>
          <text class="tl-recent-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 分段锚点（sticky） -->
  <view class="tl-segbar">
    <view
      wx:for="{{segs}}"
      wx:key="key"
      class="tl-seg"
      data-key="{{item.key}}"
      bindtap="onSeg">
      {{item.name}}
    </view>
  </view>

  <!-- 分区渲染 -->
  <block wx:for="{{sections}}" wx:key="key" wx:for-item="sec">
    <view id="sec-{{sec.key}}" class="tl-section-title">
      <view class="rule-dot"></view>
      <text class="tl-section-name">{{sec.name}}</text>
      <text class="tl-section-en">{{sec.en}}</text>
      <view class="rule-dot"></view>
    </view>

    <!-- 大卡（单列） -->
    <view class="tl-grid" wx:if="{{!sec.compact}}">
      <view
        wx:for="{{sec.items}}"
        wx:key="key"
        wx:for-item="tool"
        class="tl-card rise"
        data-url="{{tool.url}}" data-key="{{tool.key}}" data-name="{{tool.name}}"
        data-icon="{{tool.icon}}" data-cls="{{tool.cls}}"
        bindtap="onCard"
        style="animation-delay:{{index * 0.05}}s">
        <view class="tl-card-icon {{tool.cls}}">
          <view class="tl-icon-inner">{{tool.icon}}</view>
        </view>
        <view class="tl-card-body">
          <view class="tl-card-name">{{tool.name}}</view>
          <view class="tl-card-desc">{{tool.desc}}</view>
        </view>
        <view class="tl-card-arrow">›</view>
      </view>
    </view>

    <!-- 小卡（双列 · 综合实验室） -->
    <view class="tl-grid-sm" wx:else>
      <view
        wx:for="{{sec.items}}"
        wx:key="key"
        wx:for-item="tool"
        class="tl-card-sm rise"
        data-url="{{tool.url}}" data-key="{{tool.key}}" data-name="{{tool.name}}"
        data-icon="{{tool.icon}}" data-cls="{{tool.cls}}"
        bindtap="onCard"
        style="animation-delay:{{index * 0.04}}s">
        <view class="tl-card-sm-icon {{tool.cls}}">
          <view class="tl-icon-sm-inner">{{tool.icon}}</view>
          <view class="tl-3d-badge" wx:if="{{tool.is3d}}">3D</view>
        </view>
        <view class="tl-card-sm-name">{{tool.name}}</view>
        <view class="tl-card-sm-desc">{{tool.desc}}</view>
      </view>
    </view>
  </block>

  <!-- 底部说明 -->
  <view class="tl-foot">
    <view class="rule-dot"></view>
    <text class="tl-foot-text">所有公式基于 IEEE / 雷达手册标准，离线可用</text>
  </view>

</view>

<!-- pages/tools/index.wxml —— 常用工具首页 -->
<view class="screen tl">

  <!-- 标题区 -->
  <view class="tl-head rise">
    <view class="kicker">ENGINEERING TOOLS</view>
    <view class="tl-title display">常用工具</view>
    <view class="tl-sub">天线 · 雷达 · 通信 — 工程师口袋计算器</view>
  </view>

  <!-- 工具卡片网格 -->
  <view class="tl-grid">

    <!-- 专用计算 -->
    <view class="tl-card rise" bindtap="goCalc" style="animation-delay:.05s">
      <view class="tl-card-icon tl-icon-calc">
        <view class="tl-icon-inner">RF</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">专用计算</view>
        <view class="tl-card-desc">dBm↔W · 波长 · VSWR · 趋肤深度</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 天线阵列 -->
    <view class="tl-card rise" bindtap="goArray" style="animation-delay:.10s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">⬡</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">天线阵列</view>
        <view class="tl-card-desc">方向图 · 阵列因子 · 波束扫描</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 通信链路 -->
    <view class="tl-card rise" bindtap="goLink" style="animation-delay:.15s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">📶</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">通信链路</view>
        <view class="tl-card-desc">弗里斯方程 · 路径损耗 · 链路预算</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- Radar 链路 -->
    <view class="tl-card rise" bindtap="goRadar" style="animation-delay:.20s">
      <view class="tl-card-icon tl-icon-radar">
        <view class="tl-icon-inner">⊙</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">Radar 链路</view>
        <view class="tl-card-desc">雷达方程 · RCS · 多普勒频移</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 传输线 & 阻抗匹配 -->
    <view class="tl-card rise" bindtap="goMatch" style="animation-delay:.25s">
      <view class="tl-card-icon tl-icon-match">
        <view class="tl-icon-inner">Z₀</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">传输线 & 匹配</view>
        <view class="tl-card-desc">微带线 · λ/4 变换器 · L 型匹配 · 波导截止</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- Smith 圆图 -->
    <view class="tl-card rise" bindtap="goSmith" style="animation-delay:.30s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">◎</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">Smith 圆图</view>
        <view class="tl-card-desc">交互式阻抗图 · Γ/SWR/回波损耗 · 实时标点</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

  </view>

  <!-- ═══ 交互动画分区 ═══ -->
  <view class="tl-section-title">
    <view class="rule-dot"></view>
    <text class="tl-section-name">交互动画</text>
    <text class="tl-section-en">INTERACTIVE</text>
    <view class="rule-dot"></view>
  </view>

  <view class="tl-grid">

    <!-- 链路预算 -->
    <view class="tl-card rise" bindtap="goFriis" style="animation-delay:.05s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">📡</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">链路预算</view>
        <view class="tl-card-desc">Friis 单程 + 雷达双程 · Pr vs 距离曲线</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 阵列综合 -->
    <view class="tl-card rise" bindtap="goSynthesis" style="animation-delay:.10s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">⊞</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">阵列综合</view>
        <view class="tl-card-desc">均匀/余弦/汉明/切比雪夫加权 · 阵因子对比</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 阻抗圆图 -->
    <view class="tl-card rise" bindtap="goSmithChart" style="animation-delay:.15s">
      <view class="tl-card-icon tl-icon-smith">
        <view class="tl-icon-inner">◎</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">阻抗圆图</view>
        <view class="tl-card-desc">点击图面 · 实时求解 Γ / SWR / ZL</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 口径衍射 -->
    <view class="tl-card rise" bindtap="goAperture" style="animation-delay:.20s">
      <view class="tl-card-icon tl-icon-array">
        <view class="tl-icon-inner">▭</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">口径衍射</view>
        <view class="tl-card-desc">矩形/圆形口径 · 照明分布 · 远场方向图</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

    <!-- 传输线驻波 -->
    <view class="tl-card rise" bindtap="goTransmissionLine" style="animation-delay:.25s">
      <view class="tl-card-icon tl-icon-link">
        <view class="tl-icon-inner">∿</view>
      </view>
      <view class="tl-card-body">
        <view class="tl-card-name">传输线驻波</view>
        <view class="tl-card-desc">V(z)/I(z) 分布 · Γ · SWR · 短路/开路/匹配</view>
      </view>
      <view class="tl-card-arrow">›</view>
    </view>

  </view>

  <!-- 底部说明 -->
  <view class="tl-foot">
    <view class="rule-dot"></view>
    <text class="tl-foot-text">所有公式基于 IEEE / 雷达手册标准，离线可用</text>
  </view>

</view>

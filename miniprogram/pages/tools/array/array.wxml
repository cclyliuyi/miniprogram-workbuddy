<!-- pages/tools/array/array.wxml —— 天线阵列方向图实验室 -->
<view class="screen fd-page tp-page tool-studio">

  <view class="tp-head rise">
    <view class="kicker">ANTENNA ARRAY LAB</view>
    <view class="tp-title display">阵列方向图</view>
    <view class="tp-sub">均匀线阵阵因子 · 幅度加权 · 波束扫描 · 栅瓣</view>
  </view><view class="fd-stage">

  <!-- 极坐标方向图（参数变化实时重绘） -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">{{caption}}</view>
    <canvas type="2d" id="afCanvas" class="tp-canvas-tall"></canvas>
  </view>

  <!-- 参数 -->
  </view><!-- fd-stage:end --><view id="fd-anchor" class="fd-anchor"></view>
<view class="tp-section rise">
    <view class="kicker">阵列参数</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">阵元数 N</text>
      <slider class="tp-slider" min="2" max="32" step="1" value="{{N}}" bindchanging="onN" bindchange="onN" />
      <text class="tp-slider-val">{{N}} 元</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">间距 d/λ</text>
      <slider class="tp-slider" min="10" max="150" step="5" value="{{dLam100}}" bindchanging="onD" bindchange="onD" />
      <text class="tp-slider-val">{{dStr}} λ</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">扫描角 θ₀</text>
      <slider class="tp-slider" min="-60" max="60" step="1" value="{{theta0}}" bindchanging="onTheta" bindchange="onTheta" />
      <text class="tp-slider-val">{{theta0}}°</text>
    </view>
    <view class="ta-win-label">幅度加权（窗函数）</view>
    <view class="tp-btns">
      <view
        wx:for="{{windows}}"
        wx:key="*this"
        class="tp-btn {{winIdx === index ? 'active' : ''}}"
        bindtap="setWindow"
        data-i="{{index}}">
        {{item}}
      </view>
    </view>
    <view class="ta-warn" wx:if="{{gratingText}}">⚠ {{gratingText}}</view>
  </view>

  <!-- 指标读数 -->
  <view class="tp-section pop" wx:if="{{metrics}}">
    <view class="kicker">波束指标（可见区 −90°~+90°）</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">主瓣指向</view>
        <view class="tp-stat-value tp-c-accent">{{metrics.mainLobe}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">HPBW（−3dB 宽度）</view>
        <view class="tp-stat-value tp-c-teal">{{metrics.hpbw}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">最大旁瓣 SLL</view>
        <view class="tp-stat-value tp-c-gold">{{metrics.sll}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">方向性 D₀（广边近似）</view>
        <view class="tp-stat-value tp-c-indigo">{{metrics.dir}}</view>
      </view>
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式</view>
    <view class="tp-formula-line">AF(θ) = Σₙ wₙ·e^(jn·kd(sinθ−sinθ₀))，kd = 2πd/λ</view>
    <view class="tp-formula-line">D₀ ≈ 2(d/λ)(Σwₙ)²/Σwₙ²　·　栅瓣判据：d/λ ≥ 1/(1+|sinθ₀|)</view>
    <view class="tp-formula-cond">适用条件：各向同性阵元、等间距线阵；D₀ 为广边近似，d ≳ λ/2 且无栅瓣时有效；实际增益还需乘阵元方向图与效率。指标只在可见区 −90°~+90° 内统计。</view>
  </view>

  <!-- 偶极子尺寸速查 -->
  <view class="tp-section rise">
    <view class="kicker">天线尺寸速查</view>
    <view class="tp-input-row">
      <text class="tp-input-label">工作频率</text>
      <input class="tp-input num" type="digit" value="{{dipoleFreq}}" bindinput="onDipoleFreq" />
      <view class="tp-unit-group">
        <view class="tp-unit {{dipoleFreqUnit === 0 ? 'active' : ''}}" bindtap="setDipoleUnit" data-u="0">MHz</view>
        <view class="tp-unit {{dipoleFreqUnit === 1 ? 'active' : ''}}" bindtap="setDipoleUnit" data-u="1">GHz</view>
      </view>
    </view>
    <view class="tp-stats-grid" wx:if="{{dipoleResult}}">
      <view class="tp-stat">
        <view class="tp-stat-label">半波偶极子 L = λ/2</view>
        <view class="tp-stat-value tp-c-accent">{{dipoleResult.halfDipole}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">λ/4 单极子 L = λ/4</view>
        <view class="tp-stat-value tp-c-teal">{{dipoleResult.quarterMono}}</view>
      </view>
      <view class="tp-stat tp-stat-wide">
        <view class="tp-stat-label">全波环天线 周长 = λ</view>
        <view class="tp-stat-value tp-c-indigo">{{dipoleResult.fullLoop}}</view>
      </view>
    </view>
    <view class="tp-formula-cond">理想自由空间谐振长度；真实偶极子因末端效应需缩短约 5%（≈0.48λ），线越粗缩短越多。</view>
  </view>

  <!-- 直觉 -->
  <view class="tc-insight rise">
    <view class="tc-insight-kicker">直觉</view>
    <view class="tc-insight-text">窗函数是拿主瓣宽度换副瓣：<text class="tc-hl">均匀加权主瓣最窄，但副瓣只有 −13.3 dB；切比雪夫能把副瓣压到指定电平，代价是主瓣变胖</text>——切到「切比雪夫 −30dB」亲眼对比。两条安全线：d/λ ≤ 1/(1+|sinθ₀|) 无栅瓣；N 翻倍，波束窄一半、方向性 +3 dB。</view>
  </view>

<!-- floating-controls:start -->
 <cover-view id="fd-panel" hidden="{{!fdVisible}}" class="fd-panel {{fdVisible ? 'fd-visible' : ''}}" bindtouchstart="fdTouchStart" bindtouchend="fdTouchEnd" bindtouchcancel="fdTouchEnd" catchtouchmove="fdPreventScroll">
  <cover-view class="fd-head"><cover-view class="fd-title">实时调参</cover-view><cover-view class="fd-all" bindtap="fdShowAll">全部参数 ↓</cover-view></cover-view>
  <cover-view class="fd-tabs"><cover-view class="fd-tab {{fdGroup === 0 ? 'selected' : ''}}" data-group="0" bindtap="fdSelect">阵列</cover-view><cover-view class="fd-tab {{fdGroup === 1 ? 'selected' : ''}}" data-group="1" bindtap="fdSelect">扫描</cover-view></cover-view>
  <cover-view class="fd-controls"><block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">阵元数 N</cover-view>
      <cover-view id="fd-track-0" class="fd-native-track" data-id="0" data-value="{{N}}" data-min="2" data-max="32" data-step="1" data-disabled="" data-changing="onN" data-change="onN" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 0 ? fdPercent : ((N)-(2))/((32)-(2))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 0 ? fdPercent : ((N)-(2))/((32)-(2))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{N}} 元</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">间距 d/λ</cover-view>
      <cover-view id="fd-track-1" class="fd-native-track" data-id="1" data-value="{{dLam100}}" data-min="10" data-max="150" data-step="5" data-disabled="" data-changing="onD" data-change="onD" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 1 ? fdPercent : ((dLam100)-(10))/((150)-(10))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 1 ? fdPercent : ((dLam100)-(10))/((150)-(10))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{dStr}} λ</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 1}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">扫描角 θ₀</cover-view>
      <cover-view id="fd-track-2" class="fd-native-track" data-id="2" data-value="{{theta0}}" data-min="-60" data-max="60" data-step="1" data-disabled="" data-changing="onTheta" data-change="onTheta" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 2 ? fdPercent : ((theta0)-(-60))/((60)-(-60))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 2 ? fdPercent : ((theta0)-(-60))/((60)-(-60))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{theta0}}°</cover-view>
    </cover-view></block></cover-view>
 </cover-view>
<!-- floating-controls:end -->
</view>
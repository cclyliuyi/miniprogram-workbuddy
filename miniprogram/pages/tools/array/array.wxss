/* pages/tools/array/array.wxss —— 天线阵列 */
.ta { padding-top: 20rpx; }

/* ═══ 参数面板 ═══ */
.ta-params {
  padding: 28rpx;
  margin: 0 12rpx 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.ta-param-grid {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 0;
}
.ta-param {
  flex: 1;
}
.ta-param-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
  letter-spacing: .5rpx;
}
.ta-param-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 窗函数 */
.ta-window-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}
.ta-window {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  transition: all .2s;
}
.ta-window-on {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.08);
}

.ta-calc-btn {
  width: 100%;
  margin-top: 32rpx;
}

/* ═══ 方向图区域 ═══ */
.ta-chart-area {
  margin: 0 12rpx 24rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.ta-chart-title {
  margin-bottom: 16rpx;
}
.ta-canvas {
  width: 100%;
  height: 580rpx;
}

/* ═══ 结果指标 ═══ */
.ta-metrics {
  display: flex;
  margin: 0 12rpx 24rpx;
  gap: 1rpx;
  background: var(--line-soft);
  border-radius: 20rpx;
  overflow: hidden;
}
.ta-metric {
  flex: 1;
  background: var(--card);
  padding: 24rpx 8rpx;
  text-align: center;
}
.ta-metric-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.ta-metric-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

/* 警告 */
.ta-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 0 12rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(200,155,110,.10);
  border-radius: 16rpx;
  border-left: 5rpx solid var(--accent-2);
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}
.ta-note-icon {
  font-size: 28rpx;
  color: var(--accent-2);
}

/* 提示 */
.ta-tip {
  margin: 0 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

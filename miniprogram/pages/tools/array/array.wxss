/* pages/tools/array/array.wxss —— 天线阵列方向图实验室 */
@import "../../../styles/tool-ui.wxss";

/* 窗函数小标题 */
.ta-win-label {
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* 栅瓣警告条 */
.ta-warn {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #b3403a;
  background: rgba(179, 64, 58, 0.08);
  border-left: 4rpx solid #b3403a;
  border-radius: 10rpx;
}

/* pages/tools/index.wxss —— 常用工具首页 */
.tl { padding-top: 20rpx; }

/* ═══ 标题区 ═══ */
.tl-head {
  padding: 20rpx 12rpx 36rpx;
}
.tl-title {
  font-size: 52rpx;
  margin: 8rpx 0 6rpx;
  letter-spacing: -1rpx;   /* 52rpx 大标题收紧 */
  line-height: 1.05;
}
.tl-sub {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 0.5rpx;
}

/* ═══ 卡片网格 ═══ */
.tl-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 12rpx;
}

.tl-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
  transition: transform var(--dur-fast) var(--ease-spring), box-shadow var(--dur-fast) var(--ease-spring);
}
.tl-card:active {
  transform: scale(.97);
  box-shadow: 0 4rpx 24rpx rgba(32,32,28,.10);
}

/* 图标圆 */
.tl-card-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tl-icon-inner {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.tl-icon-calc {
  background: linear-gradient(135deg, rgba(176,106,79,.15), rgba(200,155,110,.15));
  color: var(--accent);
}
.tl-icon-array {
  background: linear-gradient(135deg, rgba(122,145,129,.15), rgba(143,170,152,.15));
  color: var(--sage);
}
.tl-icon-link {
  background: linear-gradient(135deg, rgba(200,155,110,.15), rgba(176,106,79,.10));
  color: var(--accent-2);
}
.tl-icon-radar {
  background: linear-gradient(135deg, rgba(176,106,79,.12), rgba(122,145,129,.12));
  color: var(--accent);
}
.tl-icon-match {
  background: linear-gradient(135deg, rgba(122,145,129,.15), rgba(143,170,152,.10));
  color: var(--sage);
}
.tl-icon-smith {
  background: linear-gradient(135deg, rgba(176,106,79,.12), rgba(200,155,110,.15));
  color: var(--accent);
}

.tl-card-body {
  flex: 1;
  min-width: 0;
}
.tl-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
}
.tl-card-desc {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: .5rpx;
}
.tl-card-arrow {
  font-size: 40rpx;
  color: var(--muted);
  opacity: .4;
  line-height: 1;
  flex-shrink: 0;
}

/* ═══ 底部 ═══ */
.tl-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 48rpx 0 40rpx;
}
.tl-foot-text {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

/* ═══ 分区标题 ═══ */
.tl-section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 12rpx 20rpx;
}
.tl-section-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-soft);
  letter-spacing: 2rpx;
}
.tl-section-en {
  font-size: 18rpx;
  color: var(--muted);
  opacity: .5;
  letter-spacing: 2rpx;
}
.tl-section-title .rule-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--muted);
  opacity: .3;
}

/* ═══ 最近使用 ═══ */
.tl-recent {
  margin: 0 12rpx 8rpx;
}
.tl-recent-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx 14rpx;
}
.tl-recent-clear {
  font-size: 22rpx;
  color: var(--muted);
  padding: 4rpx 12rpx;
}
.tl-recent-clear:active { opacity: .6; }
.tl-recent-scroll { white-space: nowrap; }
.tl-recent-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx;
}
.tl-recent-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 22rpx 12rpx 12rpx;
  background: var(--card);
  border-radius: 999rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 12rpx rgba(32,32,28,.05);
  transition: transform var(--dur-fast) var(--ease-spring);
}
.tl-recent-chip:active { transform: scale(.95); }
.tl-recent-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tl-recent-icon-inner {
  font-size: 22rpx;
  font-weight: 700;
}
.tl-recent-name {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

/* ═══ 分段锚点（sticky） ═══ */
.tl-segbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  justify-content: center;
  gap: 10rpx;
  padding: 14rpx 12rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line-soft);
}
.tl-seg {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  background: var(--card);
  border: 1rpx solid var(--line);
  transition: transform var(--dur-fast) var(--ease-spring), background var(--dur-fast);
}
.tl-seg:active {
  transform: scale(.95);
  background: rgba(200,155,110,.16);
  color: var(--accent);
}

/* ═══ 双列小卡（综合实验室） ═══ */
.tl-grid-sm {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 12rpx;
}
.tl-card-sm {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 22rpx;
  background: var(--card);
  border-radius: 18rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
  transition: transform var(--dur-fast) var(--ease-spring), box-shadow var(--dur-fast);
  overflow: hidden;
}
.tl-card-sm:active {
  transform: scale(.96);
  box-shadow: 0 4rpx 24rpx rgba(32,32,28,.10);
}
.tl-card-sm-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}
.tl-icon-sm-inner {
  font-size: 26rpx;
  font-weight: 700;
}
.tl-3d-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 2rpx 8rpx rgba(176,106,79,.35);
}
.tl-card-sm-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
}
.tl-card-sm-desc {
  font-size: 21rpx;
  color: var(--muted);
  letter-spacing: .5rpx;
  line-height: 1.45;
}
/* 工程工具入口：清晰分区，统一大符号，轻量按压反馈。 */
.tl-head { padding:28rpx 16rpx 34rpx; }
.tl-head .kicker { color:#23665f; font-size:20rpx; }
.tl-title { font-family:var(--sans); font-weight:700; line-height:1.3; }
.tl-sub { color:#746f65; line-height:1.7; }
.tl-segbar { padding:16rpx 12rpx; gap:12rpx; }
.tl-seg { flex:1; text-align:center; padding:14rpx 0; font-size:25rpx; border-radius:16rpx; color:#345e52; border-color:#d7ddd1; }
.tl-section-studio { justify-content:flex-start; padding:40rpx 16rpx 4rpx; gap:14rpx; }
.tl-section-studio .rule-dot { display:none; }
.tl-section-studio .tl-section-name { font-size:34rpx; font-weight:700; letter-spacing:0; color:#263e35; }
.tl-section-studio .tl-section-en { font-size:18rpx; color:#738176; opacity:1; letter-spacing:1rpx; }
.tl-section-intro { display:flex; align-items:center; justify-content:space-between; padding:8rpx 16rpx 24rpx; font-size:23rpx; color:#746f65; gap:12rpx; }
.tl-count { flex-shrink:0; font-size:21rpx; color:#527061; }
.tl-grid-calc { gap:14rpx; }
.tl-studio-card { position:relative; padding:26rpx; gap:22rpx; border-radius:24rpx; border-color:#e0dfd3; box-shadow:0 5rpx 18rpx rgba(32,50,40,.035); }
.tl-studio-card .tl-card-icon { width:84rpx; height:84rpx; border-radius:22rpx; color:#23665f; background:#e7eee3; }
.tl-studio-card .tl-icon-inner { font-family:var(--sans); font-size:32rpx; letter-spacing:0; }
.tl-studio-card .tl-card-name { font-size:30rpx; font-weight:600; color:#263e35; }
.tl-studio-card .tl-card-desc { font-size:23rpx; color:#77756a; line-height:1.65; letter-spacing:0; }
.tl-studio-card .tl-card-arrow { color:#567165; font-size:30rpx; opacity:1; }
.tl-card-number { display:none; }
.tl-grid-iv { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16rpx; }
.tl-grid-iv .tl-studio-card { flex-direction:column; align-items:flex-start; gap:16rpx; padding:24rpx; }
.tl-grid-iv .tl-card-icon { width:72rpx; height:72rpx; background:#dce8df; border-radius:18rpx; }
.tl-grid-iv .tl-card-body { width:100%; }
.tl-grid-iv .tl-card-desc { font-size:23rpx; min-height:76rpx; }
.tl-grid-iv .tl-card-number { display:block; position:absolute; right:24rpx; top:25rpx; color:#9aab9b; font-size:22rpx; font-variant-numeric:tabular-nums; }
.tl-grid-iv .tl-card-arrow { display:none; }
.tl-card-pressed { opacity:.78; background:#edf0e6; }

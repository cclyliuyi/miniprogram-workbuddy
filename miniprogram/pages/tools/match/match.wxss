/* pages/tools/match/match.wxss —— 传输线 & 阻抗匹配
   共享 UI 见 styles/tool-ui.wxss（tp-* 类），本文件只放页面特有样式。 */
@import "../../../styles/tool-ui.wxss";

.tl3 { padding-top: 12rpx; }

/* ═══ Tab 切换（页面特有：横向滚动药丸）═══ */
.tl3-tabs {
  margin: 0 0 24rpx;
  white-space: nowrap;
}
.tl3-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 12rpx;
}
.tl3-tab {
  display: inline-block;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: transparent;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-soft);
  white-space: nowrap;
  transition: all .2s;
}
.tl3-tab-on {
  color: #fff;
  background: var(--ink);
  border-color: var(--ink);
}

/* ═══ 页面特有微调 ═══ */
.mt-mode { margin-bottom: 16rpx; }
.mt-hint {
  font-size: 20rpx;
  color: var(--muted);
  opacity: .8;
  padding-left: 192rpx;
  margin: -4rpx 0 8rpx;
}

/* pages/tools/radar/radar.wxss —— 雷达工具（共享样板见 styles/tool-ui.wxss） */
@import "../../../styles/tool-ui.wxss";

/* 输入行下方的小字提示 */
.tr-hint {
  font-size: 20rpx;
  color: var(--muted);
  opacity: .75;
  line-height: 1.5;
  margin: -4rpx 0 10rpx 192rpx;
}

/* 结果卡里的假设/符号说明 */
.tr-assume {
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-top: 10rpx;
}

/* 模糊卡片对载频的回显（消除隐藏耦合） */
.tr-echo {
  font-size: 22rpx;
  color: var(--ink-soft);
  background: var(--paper);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin: 4rpx 0 8rpx;
}

/* 大号主结果 */
.tr-big { font-size: 48rpx; }

/* 计算结果与按钮的间距 */
.tr-result-gap { margin-top: 20rpx; }

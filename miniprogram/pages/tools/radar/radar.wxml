<!-- pages/tools/radar/radar.wxml —— 雷达工具 -->
<view class="screen tp-page">

  <view class="tp-head rise">
    <view class="kicker">RADAR TOOLKIT</view>
    <view class="tp-title display">雷达工具</view>
    <view class="tp-sub">雷达方程 · 多普勒 · PRF 模糊</view>
  </view>

  <!-- Tab 切换 -->
  <view class="tp-section rise">
    <view class="tp-btns">
      <view class="tp-btn {{radarTab === 0 ? 'active' : ''}}" bindtap="switchRadarTab" data-i="0">雷达方程</view>
      <view class="tp-btn {{radarTab === 1 ? 'active' : ''}}" bindtap="switchRadarTab" data-i="1">多普勒 / 模糊</view>
    </view>
  </view>

  <!-- ══════ 雷达方程 ══════ -->
  <block wx:if="{{radarTab === 0}}">

    <view class="tp-canvas-card rise">
      <view class="tp-canvas-caption">R_max–σ 曲线（log-log）：四次方根定律把 8 个数量级的 RCS 压成 2 个数量级的距离</view>
      <canvas type="2d" id="rangeCanvas" class="tp-canvas"></canvas>
    </view>

    <view class="tp-section rise">
      <view class="kicker">发射参数</view>
      <view class="tp-input-row">
        <text class="tp-input-label">峰值功率 Pt</text>
        <input class="tp-input num" type="digit" value="{{rPt}}" bindinput="onRPtChange" />
        <view class="tp-unit-group">
          <view class="tp-unit {{rPtUnit === 0 ? 'active' : ''}}" bindtap="setRPtUnit" data-u="0">kW</view>
          <view class="tp-unit {{rPtUnit === 1 ? 'active' : ''}}" bindtap="setRPtUnit" data-u="1">W</view>
        </view>
      </view>
      <view class="tp-input-row">
        <text class="tp-input-label">天线增益 G</text>
        <input class="tp-input num" type="digit" value="{{rG}}" bindinput="onRGChange" />
      </view>
      <view class="tr-hint">dBi（单基地：收发共用天线，方程里以 G² 出现）</view>
      <view class="tp-input-row">
        <text class="tp-input-label">频率</text>
        <input class="tp-input num" type="digit" value="{{rFreq}}" bindinput="onRFreqChange" />
        <view class="tp-unit-group">
          <view class="tp-unit {{rFreqUnit === 0 ? 'active' : ''}}" bindtap="setRFreqUnit" data-u="0">MHz</view>
          <view class="tp-unit {{rFreqUnit === 1 ? 'active' : ''}}" bindtap="setRFreqUnit" data-u="1">GHz</view>
        </view>
      </view>
    </view>

    <view class="tp-section rise">
      <view class="kicker">目标 & 接收</view>
      <view class="tp-input-row">
        <text class="tp-input-label">目标 RCS σ</text>
        <input class="tp-input num" type="digit" value="{{rcs}}" bindinput="onRcsChange" />
      </view>
      <view class="tr-hint">m²（典型：隐身机 0.0001–0.01 · 鸟 0.01 · 常规战机 1–10 · 车辆 10–50 · 舰船 1000+，跨 4 个以上数量级）</view>
      <view class="tp-input-row">
        <text class="tp-input-label">最小可检测 Smin</text>
        <input class="tp-input num" value="{{smin}}" bindinput="onSminChange" />
      </view>
      <view class="tr-hint">dBm（典型 -110 ~ -130，检测门限已隐含其中）</view>
      <view class="tp-input-row">
        <text class="tp-input-label">系统损耗 L</text>
        <input class="tp-input num" type="digit" value="{{rLoss}}" bindinput="onRLossChange" />
      </view>
      <view class="tr-hint">dB（大气、馈线、处理损耗等）</view>
      <view class="tp-cta" bindtap="calcRange">计算最大探测距离</view>
    </view>

    <view class="tp-section pop" wx:if="{{rangeResult}}">
      <view class="kicker">雷达方程结果</view>
      <view class="tp-stats-grid">
        <view class="tp-stat tp-stat-wide">
          <view class="tp-stat-label">R_max（最大探测距离）</view>
          <view class="tp-stat-value tp-c-accent tr-big num">{{rangeResult.rKm}} km</view>
        </view>
        <view class="tp-stat">
          <view class="tp-stat-label">波长 λ</view>
          <view class="tp-stat-value num">{{rangeResult.wavelength}}</view>
        </view>
        <view class="tp-stat">
          <view class="tp-stat-label">等效孔径 Ae = Gλ²/4π</view>
          <view class="tp-stat-value num">{{rangeResult.ae}}</view>
        </view>
      </view>
      <view class="tr-assume">假设：单基地、收发共用天线、单个脉冲；未计脉冲积累增益与 Pd/Pfa，Smin 已隐含检测门限。</view>
    </view>

    <view class="tp-formula rise">
      <view class="tp-formula-title">所用公式</view>
      <view class="tp-formula-line">R_max = [Pt·G²·λ²·σ / ((4π)³·S_min·L)]^(1/4)</view>
      <view class="tp-formula-line">Ae = G·λ² / 4π</view>
      <view class="tp-formula-cond">适用条件：单基地雷达、收发共用天线、自由空间传播、点目标（σ 为常数）；单脉冲检测，未计积累增益与 Pd/Pfa 统计。</view>
    </view>

    <view class="tp-note rise">
      <view class="kicker">直觉</view>
      <view class="tp-note-text">雷达最残酷的定律：R ∝ ⁴√ —— 功率 ×16 或增益 ×4，探测距离才 ×2。所以提距离靠的是大天线（G²）和低 Smin，而不是堆功率。双程往返让 λ² 站在分子上：低频看得远。</view>
    </view>
  </block>

  <!-- ══════ 多普勒 / 模糊 ══════ -->
  <block wx:if="{{radarTab === 1}}">

    <view class="tp-canvas-card rise">
      <view class="tp-canvas-caption">PRF 权衡：Ru = c/2PRF 下降 · va = λPRF/4 上升（Ru·va = cλ/8 恒定，鱼和熊掌）</view>
      <canvas type="2d" id="prfCanvas" class="tp-canvas"></canvas>
    </view>

    <view class="tp-section rise">
      <view class="kicker">多普勒频移</view>
      <view class="tp-input-row">
        <text class="tp-input-label">载频</text>
        <input class="tp-input num" type="digit" value="{{dFreq}}" bindinput="onDFreq" />
        <view class="tp-unit-group">
          <view class="tp-unit {{dFreqUnit === 0 ? 'active' : ''}}" bindtap="setDFreqUnit" data-u="0">MHz</view>
          <view class="tp-unit {{dFreqUnit === 1 ? 'active' : ''}}" bindtap="setDFreqUnit" data-u="1">GHz</view>
        </view>
      </view>
      <view class="tp-input-row">
        <text class="tp-input-label">径向速度 vr</text>
        <input class="tp-input num" value="{{dVel}}" bindinput="onDVel" />
      </view>
      <view class="tr-hint">m/s（正值 = 接近雷达 → 频移为正；填负值表示远离）</view>
      <view class="tp-cta" bindtap="calcDoppler">计算多普勒频移</view>
      <view class="tp-stats-grid tr-result-gap pop" wx:if="{{dopplerResult}}">
        <view class="tp-stat tp-stat-wide">
          <view class="tp-stat-label">多普勒频移 fd = 2·vr/λ</view>
          <view class="tp-stat-value tp-c-accent num">{{dopplerResult.fd}}</view>
          <view class="tr-assume">{{dopplerResult.dir}}</view>
        </view>
      </view>
    </view>

    <view class="tp-note rise">
      <view class="kicker">直觉</view>
      <view class="tp-note-text">fd = 2v/λ：频率越高，同样速度产生的频移越大 —— 毫米波雷达测速天然灵敏。10 GHz 下 1 m/s ≈ 67 Hz，走路的人在雷达眼里是"会唱歌的目标"。</view>
    </view>

    <view class="tp-section rise">
      <view class="kicker">距离 / 速度模糊</view>
      <view class="tp-input-row">
        <text class="tp-input-label">PRF</text>
        <input class="tp-input num" type="digit" value="{{prf}}" bindinput="onPrf" />
      </view>
      <view class="tr-hint">Hz（脉冲重复频率）</view>
      <view class="tr-echo">载频取上方输入：{{dFreq}} {{dFreqUnit === 0 ? 'MHz' : 'GHz'}}（va 依赖波长 λ）</view>
      <view class="tp-cta" bindtap="calcAmbiguity">计算模糊距离 / 速度</view>
      <view class="tp-stats-grid tr-result-gap pop" wx:if="{{ambigResult}}">
        <view class="tp-stat">
          <view class="tp-stat-label">最大不模糊距离 Ru</view>
          <view class="tp-stat-value tp-c-accent num">{{ambigResult.ru}}</view>
        </view>
        <view class="tp-stat">
          <view class="tp-stat-label">不模糊速度区间 ±va</view>
          <view class="tp-stat-value tp-c-teal num">{{ambigResult.va}}</view>
        </view>
      </view>
    </view>

    <view class="tp-formula rise">
      <view class="tp-formula-title">所用公式</view>
      <view class="tp-formula-line">fd = 2·vr / λ（vr &gt; 0 = 接近雷达，fd 为正）</view>
      <view class="tp-formula-line">Ru = c / (2·PRF)</view>
      <view class="tp-formula-line">va = λ·PRF / 4（不模糊速度为 ±va 双侧区间）</view>
      <view class="tp-formula-cond">适用条件：单基地脉冲雷达；Ru 要求回波在下一脉冲前返回（双程除 2）；va 由 |fd| ≤ PRF/2 采样定理推出。</view>
    </view>

    <view class="tp-note rise">
      <view class="kicker">直觉</view>
      <view class="tp-note-text">PRF 是鱼和熊掌：PRF 高 → 不模糊速度大但不模糊距离短；PRF 低则相反（Ru·va = cλ/8 恒定）。中 PRF 两头不靠，于是有了多重 PRF 解模糊 —— 用几把不同的"尺子"互相对账。</view>
    </view>
  </block>

</view>

<!-- pages/tools/smith/smith.wxml —— 交互式 Smith 圆图 -->
<view class="screen tp-page">

  <!-- 标题 -->
  <view class="tp-head rise">
    <view class="kicker">SMITH CHART</view>
    <view class="tp-title display">阻抗圆图</view>
    <view class="tp-sub">点击 / 拖动圆图取点，实时求解 Γ · SWR · 阻抗</view>
  </view>

  <!-- Smith 圆图 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">Γ 平面 · 外环为波长刻度（0.05λ/格，向源顺时针，λ/2 转一整圈）</view>
    <canvas
      type="2d"
      id="smithChart"
      class="smith-canvas"
      bindtouchstart="onChartTouch"
      catchtouchmove="onChartTouch"
      bindtouchend="onChartTouchEnd">
    </canvas>
  </view>

  <!-- 圆系切换 -->
  <view class="tp-section rise">
    <view class="kicker">圆系显示</view>
    <view class="tp-btns">
      <view class="tp-btn {{!showY ? 'active' : ''}}" data-y="0" bindtap="onYMode">仅阻抗圆 (r, x)</view>
      <view class="tp-btn {{showY ? 'active' : ''}}" data-y="1" bindtap="onYMode">叠加导纳圆 (g, b)</view>
    </view>
  </view>

  <!-- 输入区 -->
  <view class="tp-section rise">
    <view class="kicker">归一化阻抗输入</view>
    <view class="tp-input-row">
      <text class="tp-input-label">参考 Z₀ (Ω)</text>
      <input class="tp-input num" type="digit" value="{{z0}}" bindinput="onZ0" />
    </view>
    <view class="tp-input-row">
      <text class="tp-input-label">电阻 r = R/Z₀</text>
      <input class="tp-input num" type="digit" value="{{zR}}" bindinput="onZR" />
    </view>
    <view class="tp-input-row">
      <text class="tp-input-label">电抗 x = X/Z₀</text>
      <input class="tp-input num" type="text" value="{{zX}}" bindinput="onZX" />
    </view>
    <view class="tp-btns smith-presets">
      <view class="tp-btn" bindtap="setMatch">匹配 1+j0</view>
      <view class="tp-btn" bindtap="setShort">短路 0</view>
      <view class="tp-btn" bindtap="setOpen">开路 r→∞</view>
      <view class="tp-btn" bindtap="setExample">示例 0.5+j1</view>
    </view>
  </view>

  <!-- 结果区 -->
  <view class="tp-section pop" wx:if="{{res}}">
    <view class="kicker">反射与驻波参数</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">|Γ| 反射系数</view>
        <view class="tp-stat-value">{{res.gamma}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">∠Γ 相角</view>
        <view class="tp-stat-value">{{res.gammaDeg}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">SWR 驻波比</view>
        <view class="tp-stat-value {{res.swrClass}}">{{res.swr}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">回波损耗 RL</view>
        <view class="tp-stat-value">{{res.rl}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">失配损耗 ML</view>
        <view class="tp-stat-value">{{res.ml}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">节点 Q = |x|/r</view>
        <view class="tp-stat-value">{{res.q}}</view>
      </view>
      <view class="tp-stat tp-stat-wide">
        <view class="tp-stat-label">实际阻抗 Z = z·Z₀</view>
        <view class="tp-stat-value">{{res.zStr}}</view>
      </view>
      <view class="tp-stat tp-stat-wide">
        <view class="tp-stat-label">反射系数（复数）</view>
        <view class="tp-stat-value">{{res.gStr}}</view>
      </view>
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式</view>
    <view class="tp-formula-line">Γ = (z − 1)/(z + 1)，z = Z/Z₀　·　SWR = (1 + |Γ|)/(1 − |Γ|)</view>
    <view class="tp-formula-line">RL = −20 lg|Γ|　·　ML = −10 lg(1 − |Γ|²)　·　Q = |x|/r</view>
    <view class="tp-formula-cond">适用条件：单频稳态、参考阻抗 Z₀ 为正实数（无耗参考线）。|Γ| = 1（短路 / 开路 / 纯电抗）时 SWR 与失配损耗为 ∞、RL = 0 dB；失配损耗只计反射损失，不含负载自身欧姆损耗。沿无耗线向源移动 l，Γ 按 e^(−j2βl) 顺时针旋转，每 λ/2 转一整圈。</view>
  </view>

  <!-- 读图直觉 -->
  <view class="tp-note rise">
    <view class="kicker">读图直觉</view>
    <view class="tp-note-text">圆心 = 匹配点（|Γ|=0），最外圈 = 全反射（|Γ|=1）：点离圆心越近匹配越好。上半圆是感抗（+j，串电感往上走）、下半圆是容抗（−j，串电容往下走）；右端点开路、左端点短路。沿传输线向源移动 = 绕圆心顺时针旋转（看外环波长刻度），每走 λ/2 恰好转一整圈 —— 这就是 λ/4 线能"反转"阻抗的几何解释。叠加导纳圆后，沿等电导圆移动对应并联 L/C —— 并联匹配就在导纳圆系上做。</view>
  </view>

</view>

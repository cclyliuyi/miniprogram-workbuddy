/* pages/tools/smith/smith.wxss —— 交互式 Smith 圆图 */
.ts { padding-top: 20rpx; }

/* ═══ 标题 ═══ */
.ts-head {
  padding: 20rpx 12rpx 24rpx;
}
.ts-title {
  font-size: 48rpx;
  margin: 8rpx 0 4rpx;
}
.ts-sub {
  font-size: 24rpx;
  color: var(--muted);
}

/* ═══ Canvas ═══ */
.ts-canvas-wrap {
  margin: 0 12rpx 24rpx;
  padding: 20rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
  display: flex;
  justify-content: center;
}
.ts-canvas {
  width: 620rpx;
  height: 620rpx;
}

/* ═══ 输入区 ═══ */
.ts-section {
  margin: 0 12rpx 24rpx;
  padding: 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.ts-field {
  margin-bottom: 24rpx;
}
.ts-field-row {
  display: flex;
  gap: 16rpx;
}
.ts-field-half {
  flex: 1;
}
.ts-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.ts-hint {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
  opacity: .7;
}
.ts-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  box-sizing: border-box;
}

/* 快速按钮 */
.ts-quick-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
.ts-quick {
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  transition: all .2s;
}
.ts-quick:active {
  transform: scale(.95);
  background: rgba(176,106,79,.08);
  border-color: var(--accent);
  color: var(--accent);
}

/* ═══ 结果区 ═══ */
.ts-results {
  margin: 0 12rpx 24rpx;
  padding: 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.ts-results-title {
  margin-bottom: 20rpx;
}

.ts-result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.ts-result-card {
  width: calc(33.33% - 8rpx);
  padding: 20rpx 16rpx;
  background: var(--paper);
  border-radius: 14rpx;
  text-align: center;
}
.ts-rc-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.ts-rc-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.ts-highlight {
  color: var(--accent);
}

/* 阻抗显示 */
.ts-impedance-display {
  margin-top: 16rpx;
  padding: 24rpx;
  background: var(--paper);
  border-radius: 14rpx;
  border-left: 6rpx solid var(--sage);
}
.ts-imp-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.ts-imp-val {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: .5rpx;
}
.ts-imp-note {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  opacity: .8;
}

/* ═══ 公式说明 ═══ */
.ts-formula-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.ts-formula-item {
  font-size: 24rpx;
  color: var(--muted);
  font-family: 'SF Mono', 'Menlo', monospace;
  padding: 8rpx 0;
  letter-spacing: .5rpx;
}

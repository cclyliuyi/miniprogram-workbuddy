<!-- pages/tools/link/link.wxml —— 通信链路计算 -->
<view class="screen tl2">

  <!-- Tab 切换 -->
  <scroll-view scroll-x class="tl2-tabs" enhanced show-scrollbar="{{false}}">
    <view class="tl2-tabs-inner">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        class="tl2-tab {{activeTab === index ? 'tl2-tab-on' : ''}}"
        bindtap="switchTab"
        data-index="{{index}}">
        {{item}}
      </view>
    </view>
  </scroll-view>

  <!-- ══════ Tab1: 链路预算 ══════ -->
  <view wx:if="{{activeTab === 0}}">
    <view class="tl2-section rise">
      <view class="kicker">发射参数</view>

      <view class="tl2-field">
        <text class="tl2-label">发射功率 Pt</text>
        <view class="tl2-input-row">
          <input class="tl2-input num" type="digit" value="{{pt}}" bindinput="onPtChange" />
          <view class="tl2-unit-toggle">
            <view class="tu2 {{ptUnit === 0 ? 'tu2-on' : ''}}" bindtap="setPtUnit" data-unit="0">dBm</view>
            <view class="tu2 {{ptUnit === 1 ? 'tu2-on' : ''}}" bindtap="setPtUnit" data-unit="1">W</view>
          </view>
        </view>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">发射天线增益 Gt</text>
        <input class="tl2-input num" type="digit" value="{{gt}}" bindinput="onGtChange" />
        <text class="tl2-hint">dBi</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">频率</text>
        <view class="tl2-input-row">
          <input class="tl2-input num" type="digit" value="{{freq}}" bindinput="onFreqChange" />
          <view class="tl2-unit-toggle">
            <view class="tu2 {{freqUnit === 0 ? 'tu2-on' : ''}}" bindtap="setFreqUnit" data-unit="0">MHz</view>
            <view class="tu2 {{freqUnit === 1 ? 'tu2-on' : ''}}" bindtap="setFreqUnit" data-unit="1">GHz</view>
          </view>
        </view>
      </view>
    </view>

    <view class="tl2-section rise">
      <view class="kicker">链路参数</view>

      <view class="tl2-field">
        <text class="tl2-label">距离 R</text>
        <input class="tl2-input num" type="digit" value="{{distance}}" bindinput="onDistChange" />
        <text class="tl2-hint">km</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">接收天线增益 Gr</text>
        <input class="tl2-input num" type="digit" value="{{gr}}" bindinput="onGrChange" />
        <text class="tl2-hint">dBi</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">系统损耗 L_sys</text>
        <input class="tl2-input num" type="digit" value="{{sysLoss}}" bindinput="onLossChange" />
        <text class="tl2-hint">dB（馈线、雨衰等附加损耗）</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">接收灵敏度 P_min</text>
        <input class="tl2-input num" type="digit" value="{{sensitivity}}" bindinput="onSensChange" />
        <text class="tl2-hint">dBm（接收机最小可检测功率）</text>
      </view>
    </view>

    <button class="btn grad tl2-calc-btn" bindtap="calculate">计算链路预算</button>

    <view class="tl2-results pop" wx:if="{{result}}">
      <view class="kicker tl2-results-title">链路预算结果</view>

      <view class="tl2-result-item">
        <text class="tl2-result-label">EIRP（等效全向辐射功率）</text>
        <text class="tl2-result-value num">{{result.eirp}} dBm</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">FSPL（自由空间路径损耗）</text>
        <text class="tl2-result-value num">{{result.fspl}} dB</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">接收功率 Pr</text>
        <text class="tl2-result-value num tl2-highlight">{{result.pr}} dBm</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">链路余量（Margin）</text>
        <text class="tl2-result-value num {{result.marginClass}}">{{result.margin}} dB</text>
      </view>

      <view class="tl2-verdict {{result.verdictClass}}">
        {{result.verdict}}
      </view>
    </view>

    <view class="tc-insight">
      <view class="tc-insight-kicker">直觉</view>
      <view class="tc-insight-text"><text class="tc-hl">距离 ×2 → FSPL +6 dB；频率 ×2 同样 +6 dB</text> —— 这就是 5G 毫米波覆盖难的根本原因。链路余量 ≥10 dB 才算稳妥，余量为负的链路只存在于纸面上。</view>
    </view>
  </view>

  <!-- ══════ Tab2: 菲涅尔区 ══════ -->
  <view wx:if="{{activeTab === 1}}">
    <view class="tl2-section rise">
      <view class="kicker">菲涅尔区半径</view>

      <view class="tl2-field">
        <text class="tl2-label">频率</text>
        <view class="tl2-input-row">
          <input class="tl2-input num" type="digit" value="{{frFreq}}" bindinput="onFrFreq" />
          <view class="tl2-unit-toggle">
            <view class="tu2 {{frFreqUnit === 0 ? 'tu2-on' : ''}}" bindtap="setFrFreqUnit" data-unit="0">MHz</view>
            <view class="tu2 {{frFreqUnit === 1 ? 'tu2-on' : ''}}" bindtap="setFrFreqUnit" data-unit="1">GHz</view>
          </view>
        </view>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">距离 d₁（发射端到障碍物）</text>
        <input class="tl2-input num" type="digit" value="{{frD1}}" bindinput="onFrD1" />
        <text class="tl2-hint">km</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">距离 d₂（障碍物到接收端）</text>
        <input class="tl2-input num" type="digit" value="{{frD2}}" bindinput="onFrD2" />
        <text class="tl2-hint">km</text>
      </view>
    </view>

    <button class="btn grad tl2-calc-btn" bindtap="calcFresnel">计算菲涅尔区</button>

    <view class="tl2-results pop" wx:if="{{fresnelResult}}">
      <view class="kicker tl2-results-title">菲涅尔区结果</view>

      <view class="tl2-result-item">
        <text class="tl2-result-label">第一菲涅尔区半径 r₁</text>
        <text class="tl2-result-value num tl2-highlight">{{fresnelResult.r1}}</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">总链路距离</text>
        <text class="tl2-result-value num">{{fresnelResult.totalD}}</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">60% 净空建议（可靠通信）</text>
        <text class="tl2-result-value num">{{fresnelResult.r60}}</text>
      </view>

      <view class="tl2-verdict tl2-verdict-ok">
        障碍物与视线轴线间需保留 ≥ r₁ 的净空，否则绕射损耗增大
      </view>
      <view class="tl2-formula-box">
        <image class="tl2-formula-img" src="{{formulaLOS}}" mode="aspectFit" />
      </view>
    </view>

    <view class="tc-insight">
      <view class="tc-insight-kicker">直觉</view>
      <view class="tc-insight-text">不是"看得见"就通：<text class="tc-hl">60% 净空是工程底线</text>。2.4 GHz、10 km 链路中点的 r₁≈17.7 m —— 树梢、广告牌、楼顶水箱都可能侵入，勘察时先用这个数筛一遍。</view>
    </view>
  </view>

  <!-- ══════ Tab3: 无线电视距 ══════ -->
  <view wx:if="{{activeTab === 2}}">
    <view class="tl2-section rise">
      <view class="kicker">无线电视距（LOS）</view>

      <view class="tl2-field">
        <text class="tl2-label">发射天线高度 h_t</text>
        <input class="tl2-input num" type="digit" value="{{losHt}}" bindinput="onLosHt" />
        <text class="tl2-hint">m</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">接收天线高度 h_r</text>
        <input class="tl2-input num" type="digit" value="{{losHr}}" bindinput="onLosHr" />
        <text class="tl2-hint">m</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">等效地球半径系数 k</text>
        <view class="tl2-medium-row">
          <view class="tl2-medium {{losK === 1.0 ? 'tl2-medium-on' : ''}}" bindtap="setLosK" data-k="1.0">k=1.0 标准大气</view>
          <view class="tl2-medium {{losK === 1.333 ? 'tl2-medium-on' : ''}}" bindtap="setLosK" data-k="1.333">k=4/3 典型</view>
          <view class="tl2-medium {{losK === 0.7 ? 'tl2-medium-on' : ''}}" bindtap="setLosK" data-k="0.7">k=0.7 恶劣</view>
        </view>
      </view>
    </view>

    <button class="btn grad tl2-calc-btn" bindtap="calcLOS">计算视距</button>

    <view class="tl2-results pop" wx:if="{{losResult}}">
      <view class="kicker tl2-results-title">视距结果</view>

      <view class="tl2-result-item">
        <text class="tl2-result-label">无线电视距 d_LOS</text>
        <text class="tl2-result-value num tl2-highlight">{{losResult.dLOS}} km</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">发射侧地平线距离</text>
        <text class="tl2-result-value num">{{losResult.dHt}} km</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">接收侧地平线距离</text>
        <text class="tl2-result-value num">{{losResult.dHr}} km</text>
      </view>

      <view class="tl2-verdict tl2-verdict-ok">
        d = √(2kR·h_t) + √(2kR·h_r) · R=6371 km
      </view>
      <view class="tl2-formula-box">
        <image class="tl2-formula-img" src="{{formulaLOS}}" mode="aspectFit" />
      </view>
    </view>

    <view class="tc-insight">
      <view class="tc-insight-kicker">直觉</view>
      <view class="tc-insight-text">k=4/3 是"地球鼓起来一点"的等效：<text class="tc-hl">大气折射把射线微微掰弯，等效地球半径变大、视距变远</text>。两座 10 m 天线互视 ≈ 26 km；高度翻倍，视距只 ×1.41 —— 架高是最贵的"增益"。</view>
    </view>
  </view>

  <!-- ══════ Tab4: 热噪声与灵敏度 ══════ -->
  <view wx:if="{{activeTab === 3}}">
    <view class="tl2-section rise">
      <view class="kicker">接收机参数</view>

      <view class="tl2-field">
        <text class="tl2-label">系统带宽 B</text>
        <view class="tl2-input-row">
          <input class="tl2-input num" type="digit" value="{{nfBw}}" bindinput="onNfBw" />
          <view class="tl2-unit-toggle">
            <view class="tu2 {{nfBwUnit === 0 ? 'tu2-on' : ''}}" bindtap="setNfBwUnit" data-unit="0">kHz</view>
            <view class="tu2 {{nfBwUnit === 1 ? 'tu2-on' : ''}}" bindtap="setNfBwUnit" data-unit="1">MHz</view>
          </view>
        </view>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">噪声系数 NF</text>
        <input class="tl2-input num" type="digit" value="{{nfVal}}" bindinput="onNfVal" />
        <text class="tl2-hint">dB（系统级联总噪声系数）</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">所需最小 SNR</text>
        <input class="tl2-input num" type="digit" value="{{nfSnr}}" bindinput="onNfSnr" />
        <text class="tl2-hint">dB（解调门限信噪比，与调制方式有关）</text>
      </view>

      <view class="tl2-field">
        <text class="tl2-label">环境温度 T</text>
        <input class="tl2-input num" type="digit" value="{{nfTemp}}" bindinput="onNfTemp" />
        <text class="tl2-hint">K（开尔文，典型 290K = 17°C）</text>
      </view>
    </view>

    <button class="btn grad tl2-calc-btn" bindtap="calcNoise">计算噪声 & 灵敏度</button>

    <view class="tl2-results pop" wx:if="{{noiseResult}}">
      <view class="kicker tl2-results-title">噪声与灵敏度结果</view>

      <view class="tl2-result-item">
        <text class="tl2-result-label">热噪声功率 Pn</text>
        <text class="tl2-result-value num">{{noiseResult.pn}} dBm</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">噪声功率（线性）</text>
        <text class="tl2-result-value num">{{noiseResult.pnW}}</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">接收机灵敏度</text>
        <text class="tl2-result-value num tl2-highlight">{{noiseResult.sens}} dBm</text>
      </view>
      <view class="tl2-result-item">
        <text class="tl2-result-label">灵敏度（线性功率）</text>
        <text class="tl2-result-value num">{{noiseResult.sensW}}</text>
      </view>

      <view class="tl2-verdict tl2-verdict-ok">
        Pn = kT·B + NF · Sens = Pn + SNR_min
      </view>
      <view class="tl2-formula-box">
        <image class="tl2-formula-img" src="{{formulaNoise}}" mode="aspectFit" />
      </view>
    </view>

    <view class="tc-insight">
      <view class="tc-insight-kicker">直觉</view>
      <view class="tc-insight-text">kT·B 是宇宙的地板：<text class="tc-hl">-174 dBm/Hz，带宽 ×1000 噪声 +30 dB</text>。灵敏度 = 地板 + NF + 解调门限 —— 想听得更远，要么压低 NF（低噪放），要么收窄带宽（慢速率），没有第三条路。</view>
    </view>
  </view>

</view>

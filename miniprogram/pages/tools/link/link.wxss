/* pages/tools/link/link.wxss —— 通信链路 */
.tl2 { padding-top: 12rpx; }

/* ═══ Tab 切换 ═══ */
.tl2-tabs {
  margin: 0 0 24rpx;
  white-space: nowrap;
}
.tl2-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 12rpx;
}
.tl2-tab {
  display: inline-block;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: transparent;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-soft);
  white-space: nowrap;
  transition: all .2s;
}
.tl2-tab-on {
  color: #fff;
  background: var(--ink);
  border-color: var(--ink);
}

/* 介质/系数选择 */
.tl2-medium-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tl2-medium {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  transition: all .2s;
}
.tl2-medium-on {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.08);
}

.tl2-section {
  padding: 28rpx;
  margin: 0 12rpx 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}

.tl2-field {
  margin-bottom: 24rpx;
  position: relative;
}
.tl2-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}
.tl2-hint {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
  opacity: .7;
}
.tl2-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  box-sizing: border-box;
}
.tl2-input-row {
  display: flex;
  gap: 16rpx;
}
.tl2-input-row .tl2-input {
  flex: 1;
}
.tl2-unit-toggle {
  display: flex;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.tu2 {
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--muted);
  height: 80rpx;
}
.tu2-on {
  color: #fff;
  background: var(--ink);
}

.tl2-calc-btn {
  margin: 0 12rpx 24rpx;
  width: calc(100% - 24rpx);
}

/* 结果 */
.tl2-results {
  margin: 0 12rpx 24rpx;
  padding: 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.tl2-results-title {
  margin-bottom: 24rpx;
}
.tl2-result-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.tl2-result-label {
  font-size: 24rpx;
  color: var(--muted);
}
.tl2-result-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.tl2-highlight {
  color: var(--accent);
}

.tl2-verdict {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
.tl2-verdict-ok {
  background: rgba(122,145,129,.12);
  color: var(--sage);
}
.tl2-verdict-warn {
  background: rgba(200,155,110,.15);
  color: var(--accent-2);
}
.tl2-verdict-fail {
  background: rgba(176,106,79,.12);
  color: var(--accent);
}

.tl2-margin-ok { color: var(--sage); }
.tl2-margin-warn { color: var(--accent-2); }
.tl2-margin-fail { color: var(--accent); }

/* pages/tools/link/link.wxss —— 通信链路计算
   共享 UI 见 styles/tool-ui.wxss（tp-* 类），本文件只放页面特有样式。 */
@import "../../../styles/tool-ui.wxss";

/* 输入行右侧单位后缀 */
.lk-suffix {
  flex-shrink: 0;
  min-width: 56rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 行下小提示 */
.lk-hint {
  font-size: 20rpx;
  color: var(--muted);
  opacity: .8;
  margin: -4rpx 0 8rpx;
  line-height: 1.5;
}

/* 判定条（与画布系列色同源） */
.lk-verdict {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
.lk-ok { background: rgba(31, 138, 112, .10); color: #1f8a70; }
.lk-warn { background: rgba(176, 125, 30, .12); color: #b07d1e; }
.lk-fail { background: rgba(179, 64, 58, .10); color: #b3403a; }

/* pages/calendar/calendar.wxss —— 月历网格 · 缩略图+阳历/农历蒙版 */
.cal {
  position: relative;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* ═══════ 磨砂背景层（当月1号照片） ═══════ */
.frosted-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
}
.frosted-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(40px) brightness(1.08);
  transform: scale(1.15);
}
.frosted-overlay {
  position: absolute;
  inset: 0;
  background: rgba(243, 239, 230, 0.72);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}
@media (prefers-color-scheme: dark) {
  .frosted-overlay { background: rgba(26, 24, 20, 0.62); }
}

/* ═══════ 磨砂浮顶栏（替代大标题） ═══════ */
.float-top {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 16rpx;
  background: rgba(243, 239, 230, 0.72);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1rpx solid var(--line-soft);
}
@media (prefers-color-scheme: dark) {
  .float-top { background: rgba(26, 24, 20, 0.78); }
}
.ft-left { display: flex; align-items: baseline; gap: 12rpx; }

/* 搜索图标 */
.ft-search {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-right: 4rpx;
  align-self: center;
}
.ft-search:active { transform: scale(.9); }
.ft-search-ico {
  width: 28rpx; height: 28rpx;
  border: 3rpx solid var(--ink-soft);
  border-radius: 50%;
  position: relative;
}
.ft-search-ico::after {
  content: '';
  position: absolute;
  bottom: -7rpx; right: -5rpx;
  width: 12rpx; height: 3rpx;
  background: var(--ink-soft);
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.ft-month { font-size: 44rpx; line-height: 1; letter-spacing: -0.5rpx; }
.ft-year { font-size: 26rpx; color: var(--muted); letter-spacing: 1rpx; }
.ft-nav { display: flex; gap: 14rpx; }
.ft-btn {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--card);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--ink); line-height: 1;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,.06);
}
.ft-btn:active { background: var(--paper-2); transform: scale(.94); }

/* 「回到今天」按钮 — 鼠尾草绿强调 */
.ft-today {
  width: auto;
  min-width: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: var(--sage);
  color: #fff;
  letter-spacing: 2rpx;
}
.ft-today:active { background: #6a8275; }

/* 「故事」「年历」跳转按钮 — 胶囊型，比月份箭头稍突出 */
.ft-jump {
  width: auto;
  min-width: 64rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: rgba(122,145,129,.12);
  color: var(--sage);
  letter-spacing: 1rpx;
}
.ft-jump:active { background: rgba(122,145,129,.25); }

/* 前景内容：顶部留出浮顶栏高度 */
.cal-content {
  position: relative;
  z-index: 1;
  padding: 30rpx 30rpx 0;  /* 30rpx = 网格紧贴浮顶栏 */
}

/* ═══════ 打卡进度条 ═══════ */
.streak-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  margin: 8rpx 0 4rpx;
  background: var(--card);
  border-radius: 18rpx;
  box-shadow: 0 2rpx 16rpx rgba(32, 32, 28, .05);
}
@media (prefers-color-scheme: dark) {
  .streak-bar { background: var(--card); }
}

.streak-left, .streak-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 火焰图标（连续天数 ≥3 时高亮） */
.streak-flame {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(155, 147, 132, .2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.flame-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--muted);
}
.streak-flame.is-hot {
  background: rgba(176, 106, 79, .15);
}
.streak-flame.is-hot .flame-dot {
  background: var(--accent);
  box-shadow: 0 0 12rpx rgba(176, 106, 79, .4);
}
.streak-flame { transition: all var(--dur-base) var(--ease-spring); }

.streak-info {
  display: flex;
  flex-direction: column;
}
.streak-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}
.streak-small {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}
.streak-label {
  font-size: 18rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

.streak-sep {
  width: 1rpx;
  height: 48rpx;
  background: var(--line-soft);
}

/* 进度环（conic-gradient 填充 + 中心挖洞） */
.ring-wrap {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}
.ring-num {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 18rpx;
  font-weight: 700;
  color: var(--ink);
  z-index: 3;
}
.ring-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  transition: background var(--dur-slow) var(--ease-spring);
}
.ring-hole {
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  background: var(--card);
  z-index: 2;
}
@media (prefers-color-scheme: dark) {
  .ring-hole { background: var(--card); }
}

/* 空状态 */
.streak-empty {
  justify-content: center;
}
.streak-hint {
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  text-align: center;
}

/* ═══════ 星期头 ═══════ */
.weekbar {
  display: flex; margin: 28rpx 0 8rpx;
}
.weekbar .wd {
  flex: 1; text-align: center; font-size: 22rpx;
  color: #6b6358; letter-spacing: 2rpx; font-weight: 500;
}

/* ═══════ 日历网格 —— 核心：等宽7列 + 缩略图+双历蒙版 ═══════ */
.grid {
  display: flex;
  flex-direction: column;
  /* 左右留白由 .cal-content padding:0 20rpx 统一处理 */
}
.week {
  display: flex;
  width: 100%;
  /* 每行等高，保证所有格子底部对齐 */
  align-items: stretch;
}
.cell {
  /* 7 等分，无额外 padding 挤占空间 */
  flex: 1;
  min-width: 0;
  padding: 3rpx 3rpx;
  box-sizing: border-box;
}
.cell.is-empty { padding: 3rpx 2rpx; }

/* ─── 单日卡片（紧凑型：缩矮以腾出底部入口空间） ─── */
.cell-card {
  position: relative;
  width: 100%;
  /* 偏正方形，高度收窄 */
  aspect-ratio: 1 / 1;
  min-height: 130rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255,255,255,.72);
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 12rpx rgba(32,32,28,.05);
  transition: transform var(--dur-fast) var(--ease-spring);
}
@media (prefers-color-scheme: dark) {
  .cell-card { background: rgba(42, 39, 36, .72); }
}
.cell-card.no-img {
  background: transparent;
  border: 1rpx dashed var(--line);
  border-radius: 14rpx;
}
/* 今日高亮 — 鼠尾草绿环 + 右上角圆点标记 */
.cell-card.is-today {
  box-shadow: 0 0 0 3rpx var(--sage), 0 2rpx 12rpx rgba(122,145,129,.20);
}
/* 今日日期数字用鼠尾草绿强调 */
.cell-card.is-today .date-solar {
  color: #d4f0e0;
}
.cell-card.is-today.is-today-noimg .date-solar {
  color: var(--sage);
}
/* 右上角「今」圆点 */
.today-dot {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--sage);
  z-index: 3;
  box-shadow: 0 0 0 3rpx rgba(122,145,129,.2);
  animation: today-pulse 2s ease-in-out infinite;
}
@keyframes today-pulse {
  0%, 100% { box-shadow: 0 0 0 3rpx rgba(122,145,129,.2); }
  50% { box-shadow: 0 0 0 5rpx rgba(122,145,129,.12); }
}
.cell:active .cell-card { transform: scale(.96); }

/* 已读标记：右上角鼠尾草绿小圆点 */
.read-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--sage);
  z-index: 2;
  box-shadow: 0 0 0 3rpx rgba(255,255,255,.6);
}
/* 已读格子：柔和绿色叠加（Duolingo 风格学习地图） */
.cell-card.has-img.is-read-cell::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(122, 145, 129, 0.12);
  border-radius: inherit;
  pointer-events: none;
  z-index: 1;
}

/* 图片撑满整个卡片 */
.card-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.card-placeholder {
  width: 100%; height: 100%;
  background: repeating-linear-gradient(
    -45deg,
    rgba(200,190,175,.08),
    rgba(200,190,175,.08) 6rpx,
    transparent 6rpx,
    transparent 12rpx
  );
}

/* ─── 底部渐变蒙版 + 日期文字 ─── */
.card-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  /* 从透明到半透明的暗色渐变，不遮挡图片主体 */
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, .62) 0%,
    rgba(0, 0, 0, .28) 50%,
    transparent 100%
  );
  padding: 14rpx 10rpx 10rpx;
  z-index: 1;
}
.mask-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}
/* 阳历日期 — 大号白色粗体 */
.date-solar {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.15;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.45);
}
/* 农历日期 — 小号白色细体 */
.date-lunar {
  font-size: 18rpx;
  color: rgba(255,255,255,.85);
  line-height: 1.25;
  text-shadow: 0 1rpx 3rpx rgba(0,0,0,.4);
}
/* 节气：暖金色强调 */
.date-lunar.lunar-term {
  color: #f5d99b;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.5);
}
/* 农历节日：暖橙强调 */
.date-lunar.lunar-fest {
  color: #ffb3a0;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,.5);
}

/* 无图格子的日期样式（不用蒙版） */
.cell-card.no-img .card-mask {
  background: none;
  padding: 10rpx 8rpx;
}
.cell-card.no-img .date-solar {
  font-size: 24rpx;
  color: var(--muted);
  text-shadow: none;
  font-weight: 500;
}
.cell-card.no-img .date-lunar {
  font-size: 16rpx;
  color: var(--muted);
  opacity: .65;
  text-shadow: none;
}
.cell-card.no-img .date-lunar.lunar-term {
  color: var(--accent-2);
  opacity: 1;
  font-weight: 600;
}
.cell-card.no-img .date-lunar.lunar-fest {
  color: var(--accent);
  opacity: 1;
  font-weight: 600;
}

/* ═══════ 月度主题描述 ═══════ */
.month-blurb {
  margin: 36rpx 0 8rpx;
  padding: 32rpx 34rpx;
  background: var(--card);
  border-radius: 18rpx;
  border-left: 6rpx solid var(--accent);
  box-shadow: var(--shadow);
}
@media (prefers-color-scheme: dark) {
  .month-blurb { border-left-color: var(--accent); }
}
.blurb-tag {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 14rpx;
  font-weight: 500;
}
.blurb-theme {
  font-size: 32rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
  color: var(--ink);
}
.blurb-vibe {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}

/* ═══════ 骨架屏 ═══════ */
.sk-grid { margin-top: 8rpx; }
.sk-cell {
  width: 100%;
  aspect-ratio: 1 / 1;
  min-height: 130rpx;
  border-radius: 16rpx;
}
.perm-hint {
  margin: 40rpx 30rpx; padding: 36rpx;
  background: var(--card, #fff); border-radius: 14rpx;
  box-shadow: var(--shadow, 0 2rpx 12rpx rgba(0,0,0,.06));
}
.perm-ic { font-size: 48rpx; text-align: center; margin-bottom: 16rpx; }
.perm-title { font-size: 34rpx; text-align: center; margin-bottom: 20rpx; color: var(--accent, #b06a4f); }
.perm-desc { font-size: 26rpx; color: var(--muted, #9b9384); margin-bottom: 16rpx; }
.perm-steps {
  font-size: 24rpx; line-height: 1.8; color: var(--ink, #20201c);
  background: var(--paper, #f3efe6); padding: 20rpx 24rpx; border-radius: 10rpx;
  margin-bottom: 24rpx;
}

/* ═══════ 月份选择器（底部弹出 12 宫格） ═══════ */
.mp-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0);
  transition: background var(--dur-base) var(--ease-spring);
}
.mp-mask.mp-show {
  background: rgba(0, 0, 0, .4);
}
.mp-panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--card, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform var(--dur-base) var(--ease-spring);
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,.12);
}
.mp-mask.mp-show .mp-panel {
  transform: translateY(0);
}
.mp-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 36rpx;
  padding: 0 8rpx;
}
.mp-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink, #20201c);
  letter-spacing: 2rpx;
}
.mp-year {
  font-size: 28rpx;
  color: var(--muted, #9b9384);
  font-weight: 500;
}
.mp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.mp-cell {
  width: calc((100% - 60rpx) / 4);
  aspect-ratio: 1 / 0.72;
  border-radius: 18rpx;
  background: var(--paper-2, rgba(243,239,230,.6));
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: all var(--dur-fast) var(--ease-spring);
}
.mp-cell:active {
  transform: scale(.94);
  background: rgba(122,145,129,.12);
}
.mp-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink, #20201c);
  line-height: 1;
}
.mp-unit {
  font-size: 22rpx;
  color: var(--muted, #9b9384);
  line-height: 1;
}
/* 当前查看的月份：鼠尾草绿实心高亮 */
.mp-cell.mp-active {
  background: var(--sage, #7a9181);
  border-color: var(--sage, #7a9181);
}
.mp-cell.mp-active .mp-num,
.mp-cell.mp-active .mp-unit {
  color: #fff;
}
/* 今天所在的月份：虚线提示（区分"当前在看"和"今天"） */
.mp-cell.mp-cur-month:not(.mp-active) {
  border-color: var(--sage, #7a9181);
  border-style: dashed;
}

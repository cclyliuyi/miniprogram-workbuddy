<!-- pages/interactive/radiation-3d/radiation-3d.wxml —— 三维辐射方向图 -->
<view class="screen r3d">

  <view class="r3d-head rise">
    <view class="kicker">3D RADIATION PATTERN</view>
    <view class="r3d-title display">辐射方向图</view>
    <view class="r3d-sub">三维可视化 · 天线类型切换 · 方向性 / HPBW / 辐射电阻</view>
  </view>

  <!-- 3D Canvas -->
  <view class="r3d-canvas-wrap rise">
    <canvas type="webgl" id="three-canvas" class="r3d-canvas"
      bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd"></canvas>
    <view class="r3d-hint">单指拖动旋转 · 双指缩放</view>
  </view>

  <!-- 天线类型 -->
  <view class="r3d-section rise">
    <view class="kicker">天线类型</view>
    <view class="r3d-btns">
      <view class="r3d-btn {{S.type==='isotropic'?'on':''}}" data-t="isotropic" bindtap="onType">点源</view>
      <view class="r3d-btn {{S.type==='short'?'on':''}}" data-t="short" bindtap="onType">短偶极子</view>
      <view class="r3d-btn {{S.type==='halfwave'?'on':''}}" data-t="halfwave" bindtap="onType">半波偶极子</view>
      <view class="r3d-btn {{S.type==='fullwave'?'on':''}}" data-t="fullwave" bindtap="onType">全波偶极子</view>
      <view class="r3d-btn {{S.type==='custom'?'on':''}}" data-t="custom" bindtap="onType">自定义</view>
    </view>
  </view>

  <!-- 自定义长度 -->
  <view class="r3d-section rise" wx:if="{{S.type==='custom'}}">
    <view class="kicker">半长度 h/λ = {{hlText}}</view>
    <slider class="r3d-slider" min="5" max="200" step="1" value="{{hlSlider}}" bindchange="onHl" block-size="18" />
  </view>

  <!-- 方向图类型 -->
  <view class="r3d-section rise">
    <view class="kicker">方向图类型</view>
    <view class="r3d-seg">
      <view class="r3d-seg-btn {{S.ptype==='power'?'on':''}}" data-p="power" bindtap="onPtype">功率方向图</view>
      <view class="r3d-seg-btn {{S.ptype==='field'?'on':''}}" data-p="field" bindtap="onPtype">场方向图</view>
    </view>
  </view>

  <!-- 显示控制 -->
  <view class="r3d-section rise">
    <view class="kicker">显示控制</view>
    <view class="r3d-slider-row">
      <text class="r3d-slider-label">透明度 {{S.opacityText}}</text>
    </view>
    <slider class="r3d-slider" min="15" max="100" step="5" value="{{S.opacityVal}}" bindchange="onOpacity" block-size="18" />
    <view class="r3d-toggles">
      <view class="r3d-toggle {{S.rotate?'on':''}}" bindtap="onRotate">
        <text class="r3d-toggle-dot"></text>
        <text class="r3d-toggle-text">自动旋转</text>
      </view>
      <view class="r3d-toggle {{S.showAxes?'on':''}}" bindtap="onAxes">
        <text class="r3d-toggle-dot"></text>
        <text class="r3d-toggle-text">坐标轴</text>
      </view>
      <view class="r3d-toggle {{S.showCuts?'on':''}}" bindtap="onCuts">
        <text class="r3d-toggle-dot"></text>
        <text class="r3d-toggle-text">切线</text>
      </view>
      <view class="r3d-toggle {{S.showAnt?'on':''}}" bindtap="onAnt">
        <text class="r3d-toggle-dot"></text>
        <text class="r3d-toggle-text">天线元件</text>
      </view>
    </view>
  </view>

  <!-- 天线参数 -->
  <view class="r3d-stats pop" wx:if="{{stats}}">
    <view class="kicker r3d-stats-title">天线参数</view>
    <view class="r3d-stats-grid">
      <view class="r3d-stat">
        <view class="r3d-stat-value num">{{stats.D}}</view>
        <view class="r3d-stat-name">方向性 D</view>
      </view>
      <view class="r3d-stat">
        <view class="r3d-stat-value num">{{stats.dbi}}</view>
        <view class="r3d-stat-name">增益 dBi</view>
      </view>
      <view class="r3d-stat">
        <view class="r3d-stat-value num">{{stats.HPBW}}</view>
        <view class="r3d-stat-name">半功率波束宽度</view>
      </view>
      <view class="r3d-stat">
        <view class="r3d-stat-value num">{{stats.Rr}}</view>
        <view class="r3d-stat-name">辐射电阻</view>
      </view>
    </view>
    <!-- 色标 -->
    <view class="r3d-legend">
      <text class="r3d-legend-lo">低</text>
      <view class="r3d-legend-grad"></view>
      <text class="r3d-legend-hi">高</text>
    </view>
    <view class="r3d-legend-cap">辐射强度</view>
  </view>

  <!-- 提示 -->
  <view class="r3d-note rise">
    <view class="kicker">图例说明</view>
    <view class="r3d-note-item">白线 = E面切线（φ=0 截面）</view>
    <view class="r3d-note-item">黄线 = H面切线（θ=90° 截面）</view>
    <view class="r3d-note-item">金色元件 = 天线（沿 Y 轴）</view>
  </view>

</view>

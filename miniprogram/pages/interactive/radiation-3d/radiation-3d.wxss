/* pages/interactive/radiation-3d/radiation-3d.wxss —— 三维辐射方向图 */
@import "../../../styles/tool-ui.wxss";

/* ── WebGL 画布（纸色舞台，scene.background 同为 0xf3efe6）── */
.r3d-canvas-wrap {
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
}
.r3d-canvas {
  width: 100%;
  height: 600rpx;
  display: block;
}
.r3d-hint {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
  transition: opacity 0.6s ease;
}
.r3d-hint.fade { opacity: 0; }

/* 初始化骨架屏（纸色，遮住首帧） */
.r3d-skel {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: var(--paper);
  z-index: 2;
}
.r3d-skel-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(184, 92, 56, 0.2);
  border-top-color: rgba(184, 92, 56, 0.85);
  animation: r3d-spin 0.9s linear infinite;
}
@keyframes r3d-spin {
  to { transform: rotate(360deg); }
}
.r3d-skel-text {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 3rpx;
}
@media (prefers-reduced-motion: reduce) {
  .r3d-skel-ring { animation: none; }
  .r3d-hint { transition: none; }
}

/* ── 色标（暖色顺序渐变，与曲面顶点色同源 lab-theme ramp）── */
.r3d-legend { margin-top: 16rpx; padding: 0 8rpx; }
.r3d-legend-grad {
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(to right,
    #f6ece3, #eacdb7, #dcae8d, #cc8d66, #b86a44, #9c4f2f);
}
.r3d-legend-ticks {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
}
.r3d-legend-tick {
  font-size: 20rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
.r3d-legend-cap {
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* ── 分区内二级标题间距 ── */
.r3d-kicker-gap { margin-top: 20rpx; }

/* ── 开关组（页面特有控件，取色 var(--accent)）── */
.r3d-toggles {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 16rpx;
}
.r3d-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.r3d-toggle-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  background: var(--paper);
  display: inline-block;
  position: relative;
  transition: all 0.2s;
}
.r3d-toggle.on .r3d-toggle-dot {
  background: var(--accent);
  border-color: var(--accent);
}
.r3d-toggle.on .r3d-toggle-dot::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.r3d-toggle-text {
  font-size: 26rpx;
  color: var(--muted);
}
.r3d-toggle.on .r3d-toggle-text {
  color: var(--ink);
}

/* ── 读数卡内的说明行 ── */
.r3d-stat-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* pages/interactive/moment-method/moment-method.wxss —— 矩量法实验室
   共享 UI 见 styles/tool-ui.wxss（tp-* 类），本文件只放页面特有样式。 */
@import "../../../styles/tool-ui.wxss";

/* 矩阵热图 + 方向图 双图并排 */
.mm-canvas-row {
  display: flex;
  gap: 12rpx;
}
.mm-canvas-col {
  flex: 1;
  min-width: 0;
}
.mm-canvas-half {
  width: 100%;
  height: 340rpx;
}

/* 核适用范围提示 */
.mm-warn {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b3403a;
  background: rgba(179, 64, 58, 0.08);
  border-radius: 10rpx;
}

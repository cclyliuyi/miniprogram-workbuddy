/* pages/interactive/smith-chart/smith-chart.wxss —— 交互式 Smith 圆图 */
.sc { padding-top: 20rpx; }

.sc-head { padding: 20rpx 12rpx 24rpx; }
.sc-title { font-size: 44rpx; margin: 8rpx 0 4rpx; }
.sc-sub { font-size: 24rpx; color: var(--muted); }

.sc-canvas-wrap {
  margin: 0 12rpx 24rpx;
  padding: 20rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
  display: flex;
  justify-content: center;
}
.sc-canvas { width: 660rpx; height: 660rpx; }

.sc-section {
  margin: 0 12rpx 24rpx;
  padding: 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}

.sc-field-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.sc-field-half { flex: 1; }
.sc-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}
.sc-hint {
  display: block;
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 4rpx;
  opacity: .7;
}
.sc-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.sc-quick-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.sc-quick {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  transition: all .2s;
}
.sc-quick:active {
  transform: scale(.95);
  background: rgba(176,106,79,.08);
  border-color: var(--accent);
  color: var(--accent);
}

.sc-results {
  margin: 0 12rpx 24rpx;
  padding: 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.sc-results-title { margin-bottom: 20rpx; }

.sc-result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.sc-rc {
  width: calc(33.33% - 8rpx);
  padding: 18rpx 14rpx;
  background: var(--paper);
  border-radius: 12rpx;
  text-align: center;
}
.sc-rc-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.sc-rc-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.sc-highlight { color: var(--accent); }

.sc-impedance-display {
  margin-top: 12rpx;
  padding: 20rpx;
  background: var(--paper);
  border-radius: 12rpx;
  border-left: 6rpx solid var(--sage);
}
.sc-imp-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.sc-imp-val {
  font-size: 26rpx;
  color: var(--ink);
}

.sc-formula-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.sc-formula-item {
  font-size: 22rpx;
  color: var(--muted);
  font-family: 'SF Mono', 'Menlo', monospace;
  padding: 6rpx 0;
  letter-spacing: .5rpx;
}

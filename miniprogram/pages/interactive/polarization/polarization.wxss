/* pages/interactive/polarization/polarization.wxss —— 极化椭圆 */
.po { padding-top: 20rpx; }

.po-head { padding: 20rpx 12rpx 24rpx; }
.po-title { font-size: 44rpx; margin: 8rpx 0 4rpx; }
.po-sub { font-size: 24rpx; color: var(--muted); }

.po-canvas-wrap {
  margin: 0 12rpx 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.po-canvas-sq { width: 500rpx; height: 500rpx; margin: 0 auto; display: block; }
.po-canvas-wide { width: 686rpx; height: 320rpx; }
.po-sub-plot {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.po-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.po-section .kicker { margin-bottom: 16rpx; }

.po-preset-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.po-preset {
  flex: 1;
  min-width: calc(25% - 9rpx);
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.po-preset.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.po-slider-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.po-slider-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  width: 160rpx;
  flex-shrink: 0;
}
.po-slider { flex: 1; margin: 0 12rpx; }
.po-slider-unit {
  font-size: 22rpx;
  color: var(--muted);
  width: 48rpx;
  text-align: right;
  flex-shrink: 0;
}

.po-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.po-stats-title { margin-bottom: 16rpx; }
.po-stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.po-stat {
  width: calc(25% - 9rpx);
  padding: 18rpx 12rpx;
  background: var(--paper);
  border-radius: 14rpx;
  text-align: center;
}
.po-stat-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.po-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.po-formula-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.po-formula-item {
  font-size: 22rpx;
  color: var(--muted);
  font-family: 'SF Mono', 'Menlo', monospace;
  padding: 6rpx 0;
  letter-spacing: .5rpx;
}

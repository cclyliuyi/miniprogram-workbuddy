<!-- pages/interactive/smart-array/smart-array.wxml —— MVDR 自适应波束形成 -->
<view class="screen fd-page tp-page tool-studio">

  <view class="tp-head rise">
    <view class="kicker">ADAPTIVE BEAMFORMING</view>
    <view class="tp-title display">智能天线</view>
    <view class="tp-sub">MVDR（Capon）· 干扰功率驱动的自适应零陷</view>
  </view><view class="fd-stage">

  <!-- 方向图 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">阵列响应 |wᴴa(θ)|（dB，相对峰值）</view>
    <canvas type="2d" id="patternCanvas" class="tp-canvas"></canvas>
  </view>

  <!-- 复权值 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">复权值 wₙ：上 = 幅度 |wₙ|，下 = 相位 ∠wₙ</view>
    <canvas type="2d" id="weightsCanvas" class="tp-canvas"></canvas>
  </view>

  <!-- 阵列配置 -->
  </view><!-- fd-stage:end --><view id="fd-anchor" class="fd-anchor"></view>
<view class="tp-section rise">
    <view class="kicker">阵列配置</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">阵元数 N</text>
      <slider class="tp-slider" min="6" max="24" step="1" value="{{S.N}}"
        bindchanging="onN" bindchange="onN" />
      <text class="tp-slider-val">{{S.N}} 元</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">阵间距 d</text>
      <slider class="tp-slider" min="25" max="100" step="5" value="{{S.d100}}"
        bindchanging="onD" bindchange="onD" />
      <text class="tp-slider-val">{{S.d100 / 100}} λ</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">干噪比 JNR</text>
      <slider class="tp-slider" min="0" max="40" step="1" value="{{S.jnr}}"
        bindchanging="onJnr" bindchange="onJnr" />
      <text class="tp-slider-val">{{S.jnr}} dB</text>
    </view>
    <view class="tp-btns" style="margin-top: 12rpx;">
      <view class="tp-btn {{!S.dual ? 'active' : ''}}" data-m="1" bindtap="setMode">单干扰</view>
      <view class="tp-btn {{S.dual ? 'active' : ''}}" data-m="2" bindtap="setMode">双干扰</view>
    </view>
  </view>

  <!-- 方向控制 -->
  <view class="tp-section rise">
    <view class="kicker">方向控制</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label tp-c-teal">目标 θs</text>
      <slider class="tp-slider" min="-60" max="60" step="1" value="{{S.sig}}"
        bindchanging="onSig" bindchange="onSig" />
      <text class="tp-slider-val">{{S.sig}}°</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label tp-c-indigo">干扰1 θi₁</text>
      <slider class="tp-slider" min="-75" max="75" step="1" value="{{S.jam1}}"
        bindchanging="onJam1" bindchange="onJam1" />
      <text class="tp-slider-val">{{S.jam1}}°</text>
    </view>
    <view class="tp-slider-row" wx:if="{{S.dual}}">
      <text class="tp-slider-label tp-c-gold">干扰2 θi₂</text>
      <slider class="tp-slider" min="-75" max="75" step="1" value="{{S.jam2}}"
        bindchanging="onJam2" bindchange="onJam2" />
      <text class="tp-slider-val">{{S.jam2}}°</text>
    </view>
  </view>

  <!-- 警示 -->
  <view class="tp-note rise" wx:if="{{warn}}">
    <view class="tp-note-text tp-c-danger">注意：{{warn}}</view>
  </view>

  <!-- 读数 -->
  <view class="tp-section pop" wx:if="{{stats}}">
    <view class="kicker">实时读数</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">干扰1 零陷深度（随 JNR 变化）</view>
        <view class="tp-stat-value tp-c-indigo">{{stats.null1}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">干扰2 零陷深度</view>
        <view class="tp-stat-value tp-c-gold">{{stats.null2}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">主瓣指向（响应峰值）</view>
        <view class="tp-stat-value tp-c-teal">{{stats.beam}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">权值范数 ‖w‖（噪声放大代价）</view>
        <view class="tp-stat-value tp-c-accent">{{stats.norm}}</view>
      </view>
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式（MVDR / Capon）</view>
    <view class="tp-formula-line">w = R⁻¹a(θs) / (a(θs)ᴴ R⁻¹ a(θs))，R = σ²I + Σ JNRᵢ·a(θᵢ)a(θᵢ)ᴴ，σ² = 1</view>
    <view class="tp-formula-line">a(θ) = [1, e^{j2πd·sinθ/λ}, …, e^{j2π(N−1)d·sinθ/λ}]ᵀ</view>
    <view class="tp-formula-cond">适用条件：窄带远场点干扰、空间白噪声。零陷是软零陷，深度随 JNR 增大而加深；干扰进入主瓣（约 ±HPBW/2，HPBW ≈ 0.886λ/(Nd)）时零陷变浅、主瓣畸变、‖w‖ 激增；d/λ ≥ 1/(1+|sinθs|) 时出现栅瓣。</view>
  </view>

  <!-- 说明 -->
  <view class="tp-note rise">
    <view class="kicker">统一解释</view>
    <view class="tp-note-text">MVDR 在保持目标方向增益为 1 的前提下最小化输出总功率：干扰越强（JNR 越大）零陷越深；干扰越靠近目标，零陷被迫变浅、权值范数（噪声放大）激增——这是自适应阵的鲁棒性代价。试试把 JNR 调到 0 dB：零陷明显变浅、趋向静态方向图；或把 d 调到 1 λ：栅瓣出现。</view>
  </view>

<!-- floating-controls:start -->
 <cover-view id="fd-panel" hidden="{{!fdVisible}}" class="fd-panel {{fdVisible ? 'fd-visible' : ''}}" bindtouchstart="fdTouchStart" bindtouchend="fdTouchEnd" bindtouchcancel="fdTouchEnd" catchtouchmove="fdPreventScroll">
  <cover-view class="fd-head"><cover-view class="fd-title">实时调参</cover-view><cover-view class="fd-all" bindtap="fdShowAll">全部参数 ↓</cover-view></cover-view>
  <cover-view class="fd-tabs"><cover-view class="fd-tab {{fdGroup === 0 ? 'selected' : ''}}" data-group="0" bindtap="fdSelect">阵列</cover-view><cover-view class="fd-tab {{fdGroup === 1 ? 'selected' : ''}}" data-group="1" bindtap="fdSelect">目标</cover-view><cover-view class="fd-tab {{fdGroup === 2 ? 'selected' : ''}}" data-group="2" bindtap="fdSelect">干扰</cover-view></cover-view>
  <cover-view class="fd-controls"><block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">阵元数 N</cover-view>
      <cover-view id="fd-track-0" class="fd-native-track" data-id="0" data-value="{{S.N}}" data-min="6" data-max="24" data-step="1" data-disabled="" data-changing="onN" data-change="onN" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 0 ? fdPercent : ((S.N)-(6))/((24)-(6))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 0 ? fdPercent : ((S.N)-(6))/((24)-(6))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.N}} 元</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">阵间距 d</cover-view>
      <cover-view id="fd-track-1" class="fd-native-track" data-id="1" data-value="{{S.d100}}" data-min="25" data-max="100" data-step="5" data-disabled="" data-changing="onD" data-change="onD" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 1 ? fdPercent : ((S.d100)-(25))/((100)-(25))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 1 ? fdPercent : ((S.d100)-(25))/((100)-(25))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.d100 / 100}} λ</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 1}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">干噪比 JNR</cover-view>
      <cover-view id="fd-track-2" class="fd-native-track" data-id="2" data-value="{{S.jnr}}" data-min="0" data-max="40" data-step="1" data-disabled="" data-changing="onJnr" data-change="onJnr" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 2 ? fdPercent : ((S.jnr)-(0))/((40)-(0))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 2 ? fdPercent : ((S.jnr)-(0))/((40)-(0))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.jnr}} dB</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 1}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label tp-c-teal">目标 θs</cover-view>
      <cover-view id="fd-track-3" class="fd-native-track" data-id="3" data-value="{{S.sig}}" data-min="-60" data-max="60" data-step="1" data-disabled="" data-changing="onSig" data-change="onSig" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 3 ? fdPercent : ((S.sig)-(-60))/((60)-(-60))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 3 ? fdPercent : ((S.sig)-(-60))/((60)-(-60))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.sig}}°</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 2}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label tp-c-indigo">干扰1 θi₁</cover-view>
      <cover-view id="fd-track-4" class="fd-native-track" data-id="4" data-value="{{S.jam1}}" data-min="-75" data-max="75" data-step="1" data-disabled="" data-changing="onJam1" data-change="onJam1" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 4 ? fdPercent : ((S.jam1)-(-75))/((75)-(-75))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 4 ? fdPercent : ((S.jam1)-(-75))/((75)-(-75))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.jam1}}°</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 2}}"><cover-view class="tp-slider-row" wx:if="{{S.dual}}">
      <cover-view class="tp-slider-label tp-c-gold">干扰2 θi₂</cover-view>
      <cover-view id="fd-track-5" class="fd-native-track" data-id="5" data-value="{{S.jam2}}" data-min="-75" data-max="75" data-step="1" data-disabled="" data-changing="onJam2" data-change="onJam2" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 5 ? fdPercent : ((S.jam2)-(-75))/((75)-(-75))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 5 ? fdPercent : ((S.jam2)-(-75))/((75)-(-75))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.jam2}}°</cover-view>
    </cover-view></block></cover-view>
 </cover-view>
<!-- floating-controls:end -->
</view>
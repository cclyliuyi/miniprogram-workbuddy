/* pages/interactive/radiation-integral/radiation-integral.wxss —— 辐射积分 */
.ri { padding-top: 20rpx; }

.ri-head { padding: 20rpx 12rpx 24rpx; }
.ri-title { font-size: 44rpx; margin: 8rpx 0 4rpx; }
.ri-sub { font-size: 24rpx; color: var(--muted); }

.ri-canvas-wrap {
  margin: 0 12rpx 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.ri-canvas-wide { width: 686rpx; height: 220rpx; }
.ri-canvas-sq { width: 500rpx; height: 500rpx; margin: 0 auto; display: block; }
.ri-sub-plot {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.ri-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.ri-section .kicker { margin-bottom: 16rpx; }

.ri-btns {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.ri-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.ri-btn.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.ri-slider-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.ri-slider-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  width: 180rpx;
  flex-shrink: 0;
}
.ri-slider { flex: 1; margin: 0 12rpx; }

.ri-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.ri-stats-title { margin-bottom: 16rpx; }
.ri-stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.ri-stat {
  width: calc(50% - 6rpx);
  padding: 18rpx 20rpx;
  background: var(--paper);
  border-radius: 14rpx;
}
.ri-stat.teal .ri-stat-value { color: #28a07a; }
.ri-stat.orange .ri-stat-value { color: #c08820; }
.ri-stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.ri-stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.ri-formula-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.ri-formula-item {
  font-size: 22rpx;
  color: var(--muted);
  font-family: 'SF Mono', 'Menlo', monospace;
  padding: 6rpx 0;
  letter-spacing: .5rpx;
}

<!-- pages/interactive/friis/friis.wxml —— Friis / 雷达方程链路预算 -->
<view class="screen fd-page tp-page tool-studio">

  <view class="tp-head rise">
    <view class="kicker">FRIIS / RADAR EQUATION</view>
    <view class="tp-title display">链路预算</view>
    <view class="tp-sub">接收功率 Pr 随距离 R 的变化 · 最大作用距离 Rmax</view>
  </view><view class="fd-stage">

  <!-- 图 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">{{S.mode === 'friis' ? 'Friis 单程：每十倍距离衰减 20 dB' : '雷达双程：每十倍距离衰减 40 dB'}}</view>
    <canvas type="2d" id="chartCanvas" class="tp-canvas"></canvas>
  </view>

  <!-- 模式切换 -->
  <view class="tp-section rise">
    <view class="kicker">计算模式</view>
    <view class="tp-btns">
      <view class="tp-btn {{S.mode==='friis' ? 'active' : ''}}" bindtap="setFriis">Friis 单程</view>
      <view class="tp-btn {{S.mode==='radar' ? 'active' : ''}}" bindtap="setRadar">雷达双程</view>
    </view>
  </view>

  <!-- 发射与天线参数 -->
  </view><!-- fd-stage:end --><view id="fd-anchor" class="fd-anchor"></view>
<view class="tp-section rise">
    <view class="kicker">发射与天线参数</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">发射功率 Pt</text>
      <slider class="tp-slider" min="-10" max="60" step="1" value="{{S.pt}}"
        bindchanging="onPt" bindchange="onPt" />
      <text class="tp-slider-val">{{S.pt}} dBm</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">发射增益 Gt</text>
      <slider class="tp-slider" min="0" max="50" step="0.5" value="{{S.gt}}"
        bindchanging="onGt" bindchange="onGt" />
      <text class="tp-slider-val">{{S.gt}} dBi</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">接收增益 Gr</text>
      <slider class="tp-slider" min="0" max="50" step="0.5" value="{{S.gr}}"
        bindchanging="onGr" bindchange="onGr" />
      <text class="tp-slider-val">{{S.gr}} dBi</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">频率 f</text>
      <slider class="tp-slider" min="0.1" max="40" step="0.1" value="{{S.f}}"
        bindchanging="onFreq" bindchange="onFreq" />
      <text class="tp-slider-val">{{S.f}} GHz</text>
    </view>
  </view>

  <!-- 雷达特有参数 -->
  <view class="tp-section rise" wx:if="{{S.mode === 'radar'}}">
    <view class="kicker">雷达参数</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">目标 RCS σ</text>
      <slider class="tp-slider" min="-30" max="40" step="1" value="{{S.rcsDbsm}}"
        bindchanging="onRcs" bindchange="onRcs" />
      <text class="tp-slider-val">{{S.rcsDbsm}} dBsm</text>
    </view>
  </view>

  <!-- 距离与灵敏度 -->
  <view class="tp-section rise">
    <view class="kicker">距离与接收灵敏度</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">距离 R</text>
      <slider class="tp-slider" min="0" max="5" step="0.1" value="{{S.rExp}}"
        bindchanging="onRExp" bindchange="onRExp" />
      <text class="tp-slider-val">{{readout.R}}</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">灵敏度 Pmin</text>
      <slider class="tp-slider" min="-130" max="-40" step="1" value="{{S.smin}}"
        bindchanging="onSmin" bindchange="onSmin" />
      <text class="tp-slider-val">{{S.smin}} dBm</text>
    </view>
    <view class="fm-hint">典型灵敏度：WiFi 接收 ≈ −90 dBm · 雷达接收机 ≈ −110 dBm</view>
  </view>

  <!-- 实时读数 -->
  <view class="tp-section pop" wx:if="{{readout}}">
    <view class="kicker">实时读数 @ R = {{readout.R}}</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">接收功率 Pr</view>
        <view class="tp-stat-value {{readout.up ? 'tp-c-teal' : 'tp-c-danger'}}">{{readout.Pr}} dBm</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">{{S.mode === 'friis' ? '路径损耗 FSPL' : '双程扩散损耗 − 目标项'}}</view>
        <view class="tp-stat-value">{{readout.pathLoss}} dB</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">{{S.mode === 'friis' ? '最大通信距离 Rmax' : '最大探测距离 Rmax'}}</view>
        <view class="tp-stat-value tp-c-indigo">{{readout.maxRange}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">波长 λ</view>
        <view class="tp-stat-value">{{readout.lambda}}</view>
      </view>
    </view>
    <view class="fm-link-status {{readout.up ? 'fm-link-up' : 'fm-link-down'}}">
      {{readout.up ? '● 链路可达：Pr ≥ Pmin' : '○ 链路中断：Pr < Pmin'}}
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式</view>
    <block wx:if="{{S.mode === 'friis'}}">
      <view class="tp-formula-line">Pr = Pt + Gt + Gr − 20lg(4πR/λ)　·　λ = c/f</view>
      <view class="tp-formula-line">Rmax = (λ/4π)·10^((Pt+Gt+Gr−Pmin)/20)</view>
    </block>
    <block wx:else>
      <view class="tp-formula-line">Pr = Pt + Gt + Gr + 10lg(λ²σ) − 10lg((4π)³R⁴)</view>
      <view class="tp-formula-line">Rmax = [Pt·Gt·Gr·λ²σ / ((4π)³·Smin)]^¼</view>
    </block>
    <view class="tp-formula-cond">适用条件：远场（R &gt; 2D²/λ）、极化匹配、自由空间视距无多径；c = 299 792 458 m/s。雷达模式中"双程扩散损耗 − 目标项"已把 σ 折算进损耗读数。</view>
  </view>

<!-- floating-controls:start -->
 <cover-view id="fd-panel" hidden="{{!fdVisible}}" class="fd-panel {{fdVisible ? 'fd-visible' : ''}}" bindtouchstart="fdTouchStart" bindtouchend="fdTouchEnd" bindtouchcancel="fdTouchEnd" catchtouchmove="fdPreventScroll">
  <cover-view class="fd-head"><cover-view class="fd-title">实时调参</cover-view><cover-view class="fd-all" bindtap="fdShowAll">全部参数 ↓</cover-view></cover-view>
  <cover-view class="fd-tabs"><cover-view class="fd-tab {{fdGroup === 0 ? 'selected' : ''}}" data-group="0" bindtap="fdSelect">发射</cover-view><cover-view class="fd-tab {{fdGroup === 1 ? 'selected' : ''}}" data-group="1" bindtap="fdSelect">接收</cover-view><cover-view class="fd-tab {{fdGroup === 2 ? 'selected' : ''}}" data-group="2" bindtap="fdSelect">距离</cover-view><cover-view class="fd-tab {{fdGroup === 3 ? 'selected' : ''}}" data-group="3" bindtap="fdSelect">灵敏度</cover-view></cover-view>
  <cover-view class="fd-controls"><block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">发射功率 Pt</cover-view>
      <cover-view id="fd-track-0" class="fd-native-track" data-id="0" data-value="{{S.pt}}" data-min="-10" data-max="60" data-step="1" data-disabled="" data-changing="onPt" data-change="onPt" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 0 ? fdPercent : ((S.pt)-(-10))/((60)-(-10))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 0 ? fdPercent : ((S.pt)-(-10))/((60)-(-10))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.pt}} dBm</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">发射增益 Gt</cover-view>
      <cover-view id="fd-track-1" class="fd-native-track" data-id="1" data-value="{{S.gt}}" data-min="0" data-max="50" data-step="0.5" data-disabled="" data-changing="onGt" data-change="onGt" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 1 ? fdPercent : ((S.gt)-(0))/((50)-(0))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 1 ? fdPercent : ((S.gt)-(0))/((50)-(0))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.gt}} dBi</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 1}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">接收增益 Gr</cover-view>
      <cover-view id="fd-track-2" class="fd-native-track" data-id="2" data-value="{{S.gr}}" data-min="0" data-max="50" data-step="0.5" data-disabled="" data-changing="onGr" data-change="onGr" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 2 ? fdPercent : ((S.gr)-(0))/((50)-(0))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 2 ? fdPercent : ((S.gr)-(0))/((50)-(0))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.gr}} dBi</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 1}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">频率 f</cover-view>
      <cover-view id="fd-track-3" class="fd-native-track" data-id="3" data-value="{{S.f}}" data-min="0.1" data-max="40" data-step="0.1" data-disabled="" data-changing="onFreq" data-change="onFreq" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 3 ? fdPercent : ((S.f)-(0.1))/((40)-(0.1))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 3 ? fdPercent : ((S.f)-(0.1))/((40)-(0.1))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.f}} GHz</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 2}}"><block wx:if="{{S.mode === 'radar'}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">目标 RCS σ</cover-view>
      <cover-view id="fd-track-4" class="fd-native-track" data-id="4" data-value="{{S.rcsDbsm}}" data-min="-30" data-max="40" data-step="1" data-disabled="" data-changing="onRcs" data-change="onRcs" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 4 ? fdPercent : ((S.rcsDbsm)-(-30))/((40)-(-30))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 4 ? fdPercent : ((S.rcsDbsm)-(-30))/((40)-(-30))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.rcsDbsm}} dBsm</cover-view>
    </cover-view></block></block>
<block wx:if="{{fdGroup === 2}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">距离 R</cover-view>
      <cover-view id="fd-track-5" class="fd-native-track" data-id="5" data-value="{{S.rExp}}" data-min="0" data-max="5" data-step="0.1" data-disabled="" data-changing="onRExp" data-change="onRExp" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 5 ? fdPercent : ((S.rExp)-(0))/((5)-(0))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 5 ? fdPercent : ((S.rExp)-(0))/((5)-(0))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{readout.R}}</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 3}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">灵敏度 Pmin</cover-view>
      <cover-view id="fd-track-6" class="fd-native-track" data-id="6" data-value="{{S.smin}}" data-min="-130" data-max="-40" data-step="1" data-disabled="" data-changing="onSmin" data-change="onSmin" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 6 ? fdPercent : ((S.smin)-(-130))/((-40)-(-130))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 6 ? fdPercent : ((S.smin)-(-130))/((-40)-(-130))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.smin}} dBm</cover-view>
    </cover-view></block></cover-view>
 </cover-view>
<!-- floating-controls:end -->
</view>
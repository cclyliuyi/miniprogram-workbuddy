/* pages/interactive/friis/friis.wxss —— Friis / 雷达方程链路预算
   共享 UI 见 styles/tool-ui.wxss（tp-* 类），本文件只放页面特有样式。 */
@import "../../../styles/tool-ui.wxss";

/* 链路状态条（语义命名：up = 可达 / down = 中断） */
.fm-link-status {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx;
  border-radius: 12rpx;
}
.fm-link-up {
  color: #1f8a70;
  background: rgba(31, 138, 112, 0.10);
}
.fm-link-down {
  color: #b3403a;
  background: rgba(179, 64, 58, 0.08);
}

/* 典型值提示 */
.fm-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

<!-- pages/interactive/energy-flow-lab/energy-flow-lab.wxml —— 电磁能流账本 -->
<view class="screen tp-page">

  <view class="tp-head rise">
    <view class="kicker">UNIFIED LAB · ENERGY</view>
    <view class="tp-title display">电磁能流账本</view>
    <view class="tp-sub">端口匹配 · 近场储能 · 远场辐射 · 损耗</view>
  </view>

  <!-- 主画布 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">{{modeLabel}}</view>
    <canvas type="2d" id="mainCanvas" class="tp-canvas"></canvas>
  </view>

  <!-- 模式切换 -->
  <view class="tp-section rise">
    <view class="kicker">实验模式</view>
    <view class="tp-btns">
      <view class="tp-btn {{S.mode==='budget' ? 'active' : ''}}" data-m="budget" bindtap="setMode">功率分账</view>
      <view class="tp-btn {{S.mode==='field' ? 'active' : ''}}" data-m="field" bindtap="setMode">近场/远场</view>
      <view class="tp-btn {{S.mode==='small' ? 'active' : ''}}" data-m="small" bindtap="setMode">Chu 极限</view>
    </view>
  </view>

  <!-- 参数 -->
  <view class="tp-section rise">
    <view class="kicker">参数</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">回波损耗 RL</text>
      <slider class="tp-slider" min="0" max="30" step="1" value="{{S.rl}}" bindchanging="onRl" bindchange="onRl" />
      <text class="tp-slider-val">{{S.rl}} dB</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">辐射效率 η</text>
      <slider class="tp-slider" min="10" max="100" step="1" value="{{S.eta}}" bindchanging="onEta" bindchange="onEta" />
      <text class="tp-slider-val">{{S.eta}}%</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">电尺寸 ka</text>
      <slider class="tp-slider" min="10" max="120" step="1" value="{{S.ka100}}" bindchanging="onKa" bindchange="onKa" />
      <text class="tp-slider-val">{{S.ka100 / 100}}</text>
    </view>
  </view>

  <!-- 读数 -->
  <view class="tp-section pop" wx:if="{{stats}}">
    <view class="kicker">能流账本（严格守恒）</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">反射 |Γ|²</view>
        <view class="tp-stat-value tp-c-gold">{{stats.reflected}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">热损耗 (1−η)·接受</view>
        <view class="tp-stat-value tp-c-accent">{{stats.heat}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">远场辐射 η·接受</view>
        <view class="tp-stat-value tp-c-teal">{{stats.radiated}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">品质因数 / 带宽（VSWR≤2）</view>
        <view class="tp-stat-value tp-c-indigo">{{stats.qfbw}}</view>
      </view>
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式</view>
    <view class="tp-formula-line">|Γ|² = 10^(−RL/10)　·　P辐射 = η·(1−|Γ|²)　·　P热 = (1−η)·(1−|Γ|²)</view>
    <view class="tp-formula-line">Qmin = 1/(ka)³ + 1/(ka)　·　FBW ≈ (s−1)/(Q√s)，s = 2</view>
    <view class="tp-formula-cond">适用条件：Chu–McLean 下界针对无耗单模（TM₀₁）电小天线；含损天线 Q ≈ η·Qmin。</view>
  </view>

  <!-- 说明 -->
  <view class="tp-note rise">
    <view class="kicker">统一解释</view>
    <view class="tp-note-text">{{noteText}}</view>
  </view>

</view>

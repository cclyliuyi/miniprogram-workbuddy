/* pages/interactive/energy-flow-lab/energy-flow-lab.wxss —— 能流账本 */
.ef { padding-top: 20rpx; }

.ef-head { padding: 20rpx 12rpx 24rpx; }
.ef-title { font-size: 40rpx; margin: 8rpx 0 4rpx; }
.ef-sub { font-size: 24rpx; color: var(--muted); }

.ef-canvas-wrap {
  margin: 0 12rpx 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.ef-canvas { width: 686rpx; height: 520rpx; }
.ef-sub-plot {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.ef-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.ef-section .kicker { margin-bottom: 16rpx; }

.ef-btns {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.ef-btn {
  flex: 1;
  min-width: 180rpx;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.ef-btn.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.ef-slider-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.ef-slider-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  width: 180rpx;
  flex-shrink: 0;
}
.ef-slider { flex: 1; margin: 0 12rpx; }

.ef-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.ef-stats-title { margin-bottom: 16rpx; }
.ef-stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.ef-stat {
  width: calc(50% - 6rpx);
  padding: 18rpx 20rpx;
  background: var(--paper);
  border-radius: 14rpx;
}
.ef-stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.ef-stat-value {
  font-size: 30rpx;
  font-weight: 600;
}
.ef-red { color: #c6404e; }
.ef-gold { color: #c09020; }
.ef-blue { color: #4a78d8; }
.ef-green { color: #1a9c7e; }

.ef-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.ef-note-text {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}

<!-- pages/interactive/index.wxml —— 交互模块入口列表 -->
<view class="screen iv">

  <!-- 标题区 -->
  <view class="iv-head rise">
    <view class="kicker">INTERACTIVE MODULES</view>
    <view class="iv-title display">交互动画</view>
    <view class="iv-sub">拖动滑块 · 实时求解 — 让公式动起来</view>
  </view>

  <!-- 模块卡片网格 -->
  <view class="iv-grid">

    <!-- Friis / 雷达方程 -->
    <view class="iv-card rise" bindtap="goFriis" style="animation-delay:.05s">
      <view class="iv-card-icon iv-icon-link">
        <view class="iv-icon-inner">📡</view>
      </view>
      <view class="iv-card-body">
        <view class="iv-card-name">链路预算</view>
        <view class="iv-card-desc">Friis 单程 + 雷达双程 · Pr vs 距离曲线</view>
      </view>
      <view class="iv-card-arrow">›</view>
    </view>

    <!-- 方向图综合 -->
    <view class="iv-card rise" bindtap="goSynthesis" style="animation-delay:.10s">
      <view class="iv-card-icon iv-icon-array">
        <view class="iv-icon-inner">⊞</view>
      </view>
      <view class="iv-card-body">
        <view class="iv-card-name">阵列综合</view>
        <view class="iv-card-desc">均匀/余弦/汉明/切比雪夫加权 · 阵因子对比</view>
      </view>
      <view class="iv-card-arrow">›</view>
    </view>

    <!-- Smith 圆图 -->
    <view class="iv-card rise" bindtap="goSmithChart" style="animation-delay:.15s">
      <view class="iv-card-icon iv-icon-smith">
        <view class="iv-icon-inner">◎</view>
      </view>
      <view class="iv-card-body">
        <view class="iv-card-name">阻抗圆图</view>
        <view class="iv-card-desc">点击图面 · 实时求解 Γ / SWR / ZL</view>
      </view>
      <view class="iv-card-arrow">›</view>
    </view>

    <!-- 口径场 -->
    <view class="iv-card rise" bindtap="goAperture" style="animation-delay:.20s">
      <view class="iv-card-icon iv-icon-aperture">
        <view class="iv-icon-inner">▭</view>
      </view>
      <view class="iv-card-body">
        <view class="iv-card-name">口径衍射</view>
        <view class="iv-card-desc">矩形/圆形口径 · 照明分布 · 远场方向图</view>
      </view>
      <view class="iv-card-arrow">›</view>
    </view>

    <!-- 传输线 -->
    <view class="iv-card rise" bindtap="goTransmissionLine" style="animation-delay:.25s">
      <view class="iv-card-icon iv-icon-tline">
        <view class="iv-icon-inner">∿</view>
      </view>
      <view class="iv-card-body">
        <view class="iv-card-name">传输线驻波</view>
        <view class="iv-card-desc">V(z) / I(z) 分布 · Γ · SWR · 短路/开路/匹配</view>
      </view>
      <view class="iv-card-arrow">›</view>
    </view>

  </view>

  <!-- 底部说明 -->
  <view class="iv-foot">
    <view class="rule-dot"></view>
    <text class="iv-foot-text">基于教材《Antennas & Propagation》交互模块移植</text>
  </view>

</view>

<!-- pages/interactive/3d-lab/phased-array/phased-array.wxml —— 相控阵 3D -->
<view class="screen pa3d">

  <view class="lab3d-head rise">
    <view class="kicker">PHASED ARRAY · 3D BEAM STEERING</view>
    <view class="lab3d-title display">相控阵扫描</view>
    <view class="lab3d-sub">3D 方向图 · 渐进相移 β · 栅瓣锥环</view>
  </view>

  <!-- 3D Canvas -->
  <view class="lab3d-canvas-wrap rise">
    <canvas type="webgl" id="three-canvas" class="lab3d-canvas"
      catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"></canvas>
    <view class="lab3d-hint">单指拖动旋转 · 双指缩放 · 绿环=主瓣 · 红环=栅瓣</view>
  </view>

  <!-- 阵列配置 -->
  <view class="lab3d-section rise">
    <view class="kicker">阵列配置</view>
    <view class="pa3d-row">
      <text class="lab3d-label">阵元数 N</text>
      <text class="lab3d-val">{{S.N}}</text>
    </view>
    <slider min="2" max="24" step="1" value="{{S.N}}" bindchange="onN" block-size="18" />
    <view class="pa3d-row">
      <text class="lab3d-label">间距 d/λ</text>
      <text class="lab3d-val">{{S.d}}</text>
    </view>
    <slider min="0.1" max="1.5" step="0.01" value="{{S.d}}" bindchange="onD" block-size="18" />
  </view>

  <!-- 波束扫描 -->
  <view class="lab3d-section rise">
    <view class="kicker">波束扫描 ★</view>
    <view class="pa3d-row">
      <text class="lab3d-label">渐进相移 β</text>
      <text class="lab3d-val pa3d-accent">{{S.beta}}°</text>
    </view>
    <slider min="-180" max="180" step="1" value="{{S.beta}}" bindchange="onBeta" block-size="18" />
    <view class="pa3d-preset-btns">
      <view class="pa3d-preset {{S.beta > 60 ? 'active' : ''}}" bindtap="setEndfireBack">端射 ←</view>
      <view class="pa3d-preset {{S.beta === 0 ? 'active' : ''}}" bindtap="setBroadside">边射</view>
      <view class="pa3d-preset {{S.beta < -60 ? 'active' : ''}}" bindtap="setEndfireFwd">端射 →</view>
    </view>
    <view class="pa3d-scan-toggle" bindtap="toggleScan">
      <view class="pa3d-scan-btn {{scanOn ? 'on' : ''}}">自动扫描动画 {{scanOn ? '●' : '○'}}</view>
    </view>
  </view>

  <!-- 阵元因子 -->
  <view class="lab3d-section rise">
    <view class="kicker">阵元因子</view>
    <view class="pa3d-preset-btns">
      <view class="pa3d-preset {{S.el === 'iso' ? 'active' : ''}}" bindtap="setIso">各向同性</view>
      <view class="pa3d-preset {{S.el === 'dipole' ? 'active' : ''}}" bindtap="setDipole">半波偶极子</view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="lab3d-stats pop" wx:if="{{stats}}">
    <view class="kicker lab3d-stats-title">阵列参数</view>
    <view class="lab3d-stats-grid">
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{stats.theta}}°</view>
        <view class="lab3d-stat-name">波束指向 θ₀</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{stats.dbi}}</view>
        <view class="lab3d-stat-name">方向性 dBi</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{stats.hpbw}}°</view>
        <view class="lab3d-stat-name">HPBW</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{stats.sll}} dB</view>
        <view class="lab3d-stat-name">副瓣电平</view>
      </view>
    </view>
    <view class="pa3d-grating-warn" wx:if="{{stats.grating > 0}}">
      ⚠ 检测到 {{stats.grating}} 个栅瓣 — 阵元间距过大，能量泄漏到非预期方向。减小 d/λ 可消除。
    </view>
  </view>

  <!-- 2D 极坐标子图 -->
  <view class="lab3d-section rise">
    <view class="kicker">E 面方向图 (dB)</view>
    <canvas type="2d" id="plot" class="lab3d-2d"></canvas>
  </view>

  <!-- 公式说明 -->
  <view class="lab3d-note rise">
    <view class="kicker">核心公式</view>
    <view class="lab3d-note-item">AF(θ) = sin(Nψ/2) / [N·sin(ψ/2)]</view>
    <view class="lab3d-note-item">ψ = kd·cosθ + β （β = 渐进相移）</view>
    <view class="lab3d-note-item">栅瓣条件：d/λ > 1/(1+|cosθ₀|)</view>
    <view class="lab3d-note-item">方向图相乘原理：总方向图 = 阵因子 × 阵元因子</view>
  </view>

</view>

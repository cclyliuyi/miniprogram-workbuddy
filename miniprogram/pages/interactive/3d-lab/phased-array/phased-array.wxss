/* pages/interactive/3d-lab/phased-array/phased-array.wxss —— 相控阵 3D */
@import "../loop/loop.wxss";

/* ── 特有样式 ── */
.pa3d-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 4rpx;
}
.pa3d-accent { color: #b06a4f; }

.pa3d-preset-btns {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.pa3d-preset {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.pa3d-preset.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.pa3d-scan-toggle {
  margin-top: 12rpx;
}
.pa3d-scan-btn {
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.pa3d-scan-btn.on {
  color: var(--sage);
  border-color: var(--sage);
  background: rgba(122,145,129,.08);
  font-weight: 600;
}

.pa3d-grating-warn {
  margin-top: 12rpx;
  padding: 14rpx;
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(176,106,79,.08);
  border: 1rpx solid rgba(176,106,79,.2);
  border-radius: 12rpx;
  line-height: 1.5;
}

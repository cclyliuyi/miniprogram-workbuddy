/* 微波暗室 — 共享舞台样式（内含 tool-ui.wxss） */
@import "../lab3d.wxss";
.lab3d-canvas { width:100%; height:680rpx; }
.scene-topline { display:flex; justify-content:space-between; padding:22rpx 22rpx 0; font-size:23rpx; color:#657b85; }
.scan-status { color:#177b84; }
.lab3d-canvas-wrap { background:#f3efe6; border-color:#dbe0db; }
.scene-tools { display:flex; justify-content:center; gap:14rpx; margin:8rpx 12rpx 18rpx; }
.view-choice { padding:10rpx 28rpx; font-size:26rpx; color:#61757e; border:1rpx solid #d3dcd9; border-radius:10rpx; }
.view-choice.selected { background:#e3eeea; color:#176d75; border-color:#a9c5bf; }
.scene-key { display:flex; flex-wrap:wrap; justify-content:center; gap:16rpx; font-size:23rpx; color:#65787e; margin:0 12rpx 30rpx; }
.lab3d-sub { font-size:27rpx; line-height:1.7; margin-top:16rpx; }
.lab3d-head .kicker { font-size:21rpx; letter-spacing:2rpx; }
.lab3d-stat-value { font-size:34rpx; }
.tp-canvas { width:100%; height:650rpx; }
.plot-heading { font-size:32rpx; font-weight:600; color:#213e50; padding:20rpx 24rpx 4rpx; }
.plot-description { font-size:23rpx; line-height:1.7; color:#79878c; padding:0 24rpx; }
.plot-legend { display:flex; justify-content:center; gap:24rpx; font-size:24rpx; color:#637078; padding:12rpx 8rpx 26rpx; }
.plot-legend view { display:flex; align-items:center; gap:10rpx; }
.legend-line { width:30rpx; height:0; border-top:3rpx solid; }
.reference { border-color:#8d9da8; border-top-style:dashed; }
.sampled { border-color:#b46a3e; }
.legend-dot { width:12rpx; height:12rpx; border-radius:50%; background:#16838f; }
.scan-button { display:flex; align-items:center; justify-content:center; gap:14rpx; }
.control-icon { display:inline-block; width:20rpx; height:22rpx; box-sizing:border-box; }
.play-icon { width:0; height:0; border-top:11rpx solid transparent; border-bottom:11rpx solid transparent; border-left:17rpx solid currentColor; }
.pause-icon { border-left:6rpx solid currentColor; border-right:6rpx solid currentColor; }
.clear-icon { border:2rpx solid currentColor; border-radius:3rpx; position:relative; }
.clear-icon::before { content:''; position:absolute; width:24rpx; height:2rpx; top:-7rpx; left:-4rpx; background:currentColor; }
.tp-formula-line, .tp-formula-cond { font-size:26rpx; line-height:1.9; }

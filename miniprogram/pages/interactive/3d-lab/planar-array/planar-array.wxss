/* pages/interactive/3d-lab/planar-array/planar-array.wxss —— 平面相控阵 3D
   公共舞台样式取自 ../lab3d.wxss（内含 tool-ui.wxss） */
@import "../lab3d.wxss";

/* ── 配置行（标签 + 分段选择器）── */
.pla-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.pla-row:last-child { margin-bottom: 0; }
.pla-row-label {
  font-size: 26rpx;
  color: var(--muted);
  flex-shrink: 0;
}

/* ── 分段选择器 ── */
.pla-seg {
  display: flex;
  background: var(--bg-soft);
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  overflow: hidden;
}
.pla-seg-item {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--muted);
  border-right: 1rpx solid var(--line);
  transition: all var(--dur-fast, 180ms) var(--ease-out, cubic-bezier(0.16,1,0.3,1));
  font-variant-numeric: tabular-nums;
}
.pla-seg-item:last-child { border-right: none; }
.pla-seg-item.on {
  background: var(--accent, #b85c38);
  color: var(--card, #fbf9f4);
  font-weight: 600;
}

/* ── 9 宫格波束指向预设 ── */
.pla-pad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  max-width: 320rpx;
  margin: 0 auto 22rpx;
}
.pla-pad-item {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--muted);
  background: var(--bg-soft);
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  transition: all var(--dur-fast, 180ms) var(--ease-out, cubic-bezier(0.16,1,0.3,1));
  font-family: var(--font-mono, monospace);
}
.pla-pad-item:active,
.pla-pad-item.on {
  background: rgba(184, 92, 56, 0.12);
  border-color: var(--accent, #b85c38);
  color: var(--accent, #b85c38);
  transform: scale(0.96);
}

/* ── 锥削效率说明行 ── */
.pla-eta-line {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* ── 无障碍：减弱动画时去掉缩放与过渡 ── */
@media (prefers-reduced-motion: reduce) {
  .pla-seg-item,
  .pla-pad-item { transition: none; }
  .pla-pad-item:active { transform: none; }
}

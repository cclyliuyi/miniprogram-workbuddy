<!-- pages/interactive/3d-lab/polarization/polarization.wxml —— 极化椭圆 3D -->
<view class="screen fd-page lab3d">

  <view class="lab3d-head ">
    <view class="kicker">POLARIZATION · 3D TRAVELING WAVE</view>
    <view class="lab3d-title display">极化椭圆</view>
    <view class="lab3d-sub">3D 行进波 · Ex / Ey 分量 · 线/圆/椭圆极化</view>
  </view><view class="fd-stage">

  <!-- 3D Canvas -->
  <view class="lab3d-canvas-wrap ">
    <canvas type="webgl" id="three-canvas" class="lab3d-canvas"
      catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"></canvas>
    <view wx:if="{{!glReady}}" class="lab3d-skel">
      <view class="lab3d-skel-ring"></view>
      <text class="lab3d-skel-text">正在初始化 3D 场景…</text>
    </view>
    <view class="lab3d-hint {{showHint ? '' : 'fade'}}">赤陶=Ex · 青绿=Ey · 赭金=合成 E · 双击复位</view>
  </view>

  <view class="lab-viewbar">
    <view class="lab-view-choice {{labView==='perspective'?'selected':''}}" data-view="perspective" bindtap="onLabView">立体全景</view>
    <view class="lab-view-choice {{labView==='front'?'selected':''}}" data-view="front" bindtap="onLabView">正视</view>
    <view class="lab-view-choice {{labView==='top'?'selected':''}}" data-view="top" bindtap="onLabView">俯视</view>
    <view class="lab-view-choice {{autoRotate?'selected':''}}" bindtap="onLabRotate">{{autoRotate?'停止环视':'自动环视'}}</view>
  </view>
<view class="lab-scene-caption">Ex / Ey 分量 · 合成电场</view>

  <!-- 端面极化椭圆 -->
  <view class="tp-canvas-card ">
    <view class="tp-canvas-caption">z=0 端面极化椭圆 · +z 出屏（迎波观察：右旋呈逆时针）</view>
    <canvas type="2d" id="ellipse" class="tp-canvas-tall"></canvas>
  </view>

  <!-- 预设 -->
  <view class="lab3d-section ">
    <view class="kicker">预设</view>
    <view class="tp-btns">
      <view class="tp-btn {{S.preset==='linear' ? 'active' : ''}}" bindtap="setLinear">线极化</view>
      <view class="tp-btn {{S.preset==='rhcp' ? 'active' : ''}}" bindtap="setRHCP">右旋圆</view>
      <view class="tp-btn {{S.preset==='lhcp' ? 'active' : ''}}" bindtap="setLHCP">左旋圆</view>
      <view class="tp-btn {{S.preset==='ellipse' ? 'active' : ''}}" bindtap="setEllipse">椭圆</view>
    </view>
  </view>

  <!-- 参数滑块 -->
  </view><!-- fd-stage:end --><view id="fd-anchor" class="fd-anchor"></view>
<view class="lab3d-section ">
    <view class="kicker">场分量参数</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">Ex 幅度</text>
      <slider class="tp-slider" min="0" max="1" step="0.01" value="{{S.ex}}"
        bindchanging="onExChanging" bindchange="onEx" />
      <text class="tp-slider-val">{{S.ex}}</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">Ey 幅度</text>
      <slider class="tp-slider" min="0" max="1" step="0.01" value="{{S.ey}}"
        bindchanging="onEyChanging" bindchange="onEy" />
      <text class="tp-slider-val">{{S.ey}}</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">相位差 δ</text>
      <slider class="tp-slider" min="-180" max="180" step="1" value="{{S.del}}"
        bindchanging="onDelChanging" bindchange="onDel" />
      <text class="tp-slider-val">{{S.del}}°</text>
    </view>
  </view>

  <!-- 读数 -->
  <view class="lab3d-stats " wx:if="{{params}}">
    <view class="kicker lab3d-stats-title">极化读数</view>
    <view class="lab3d-stats-grid">
      <view class="lab3d-stat">
        <view class="lab3d-stat-value">{{params.type}}</view>
        <view class="lab3d-stat-name">类型</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num tp-c-gold">{{params.ar}}</view>
        <view class="lab3d-stat-name">轴比 AR（{{params.arDb}}）</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num tp-c-indigo">{{params.tilt}}°</view>
        <view class="lab3d-stat-name">倾角 ψ</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value">{{params.sense}}</view>
        <view class="lab3d-stat-name">旋向（IEEE，顺 +z 观察）</view>
      </view>
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula ">
    <view class="tp-formula-title">所用公式</view>
    <view class="tp-formula-line">E(z,t) = x̂·Ex·cos(ωt−βz) + ŷ·Ey·cos(ωt−βz+δ)</view>
    <view class="tp-formula-line">tan2ψ = 2ExEy·cosδ / (Ex²−Ey²)　·　sin2χ = 2ExEy·sinδ / (Ex²+Ey²)</view>
    <view class="tp-formula-line">AR = 长轴/短轴 = 1/|tanχ|　·　AR(dB) = 20·lg AR</view>
    <view class="tp-formula-cond">适用条件：单色均匀平面波。IEEE 旋向约定：顺 +z 传播方向观察，δ&lt;0 右旋、δ&gt;0 左旋（2D 端面图 +z 出屏、迎波观察，右旋因此呈逆时针）。分类为教学阈值：AR&lt;3 dB 记圆极化（工程惯例），AR&gt;30 dB 记线极化，线极化时旋向恒为"无"。</view>
  </view>

  <!-- 说明 -->
  <view class="lab3d-note ">
    <view class="kicker">图例</view>
    <view class="lab3d-note-item">3D：赤陶曲线 = Ex 分量 · 青绿曲线 = Ey 分量 · 赭金曲线/矢量 = 合成 E（沿 +z 行进）</view>
    <view class="lab3d-note-item">2D：赭金轨迹 = E 端点 · 靛蓝虚线 = 椭圆长短轴与倾角 ψ · 灰虚线框 = 2Ex×2Ey 参考</view>
  </view>

<!-- floating-controls:start -->
 <cover-view id="fd-panel" hidden="{{!fdVisible}}" class="fd-panel {{fdVisible ? 'fd-visible' : ''}}" bindtouchstart="fdTouchStart" bindtouchend="fdTouchEnd" bindtouchcancel="fdTouchEnd" catchtouchmove="fdPreventScroll">
  <cover-view class="fd-head"><cover-view class="fd-title">实时调参</cover-view><cover-view class="fd-all" bindtap="fdShowAll">全部参数 ↓</cover-view></cover-view>
  <cover-view class="fd-tabs"><cover-view class="fd-tab {{fdGroup === 0 ? 'selected' : ''}}" data-group="0" bindtap="fdSelect">幅度</cover-view><cover-view class="fd-tab {{fdGroup === 1 ? 'selected' : ''}}" data-group="1" bindtap="fdSelect">相位</cover-view></cover-view>
  <cover-view class="fd-controls"><block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">Ex 幅度</cover-view>
      <cover-view id="fd-track-0" class="fd-native-track" data-id="0" data-value="{{S.ex}}" data-min="0" data-max="1" data-step="0.01" data-disabled="" data-changing="onExChanging" data-change="onEx" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 0 ? fdPercent : ((S.ex)-(0))/((1)-(0))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 0 ? fdPercent : ((S.ex)-(0))/((1)-(0))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.ex}}</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 0}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">Ey 幅度</cover-view>
      <cover-view id="fd-track-1" class="fd-native-track" data-id="1" data-value="{{S.ey}}" data-min="0" data-max="1" data-step="0.01" data-disabled="" data-changing="onEyChanging" data-change="onEy" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 1 ? fdPercent : ((S.ey)-(0))/((1)-(0))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 1 ? fdPercent : ((S.ey)-(0))/((1)-(0))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.ey}}</cover-view>
    </cover-view></block>
<block wx:if="{{fdGroup === 1}}"><cover-view class="tp-slider-row">
      <cover-view class="tp-slider-label">相位差 δ</cover-view>
      <cover-view id="fd-track-2" class="fd-native-track" data-id="2" data-value="{{S.del}}" data-min="-180" data-max="180" data-step="1" data-disabled="" data-changing="onDelChanging" data-change="onDel" catchtouchstart="fdNativeStart" catchtouchmove="fdNativeMove" catchtouchend="fdNativeEnd" catchtouchcancel="fdNativeEnd"><cover-view class="fd-native-rail"></cover-view><cover-view class="fd-native-fill" style="width:{{fdActiveId === 2 ? fdPercent : ((S.del)-(-180))/((180)-(-180))*100}}%"></cover-view><cover-view class="fd-native-thumb" style="left:{{fdActiveId === 2 ? fdPercent : ((S.del)-(-180))/((180)-(-180))*100}}%"></cover-view></cover-view>
      <cover-view class="tp-slider-val">{{S.del}}°</cover-view>
    </cover-view></block></cover-view>
 </cover-view>
<!-- floating-controls:end -->
</view>
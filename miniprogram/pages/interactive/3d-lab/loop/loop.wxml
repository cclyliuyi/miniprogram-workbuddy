<!-- pages/interactive/3d-lab/loop/loop.wxml —— 小环天线 3D -->
<view class="screen lab3d">

  <view class="lab3d-head rise">
    <view class="kicker">SMALL LOOP · MAGNETIC DIPOLE</view>
    <view class="lab3d-title display">小环天线</view>
    <view class="lab3d-sub">磁偶极子模型 · 辐射电阻 · sin²θ 方向图</view>
  </view>

  <view class="lab3d-canvas-wrap rise">
    <canvas type="webgl" id="three-canvas" class="lab3d-canvas"
      catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"></canvas>
    <view class="lab3d-hint">单指拖动旋转 · 双指缩放</view>
  </view>

  <!-- 参数控制 -->
  <view class="lab3d-section rise">
    <view class="kicker">几何与损耗</view>
    <view class="lab3d-row">
      <text class="lab3d-label">半径 a/λ</text>
      <text class="lab3d-val">{{aVal}}</text>
    </view>
    <slider min="10" max="200" step="2" value="{{aSlider}}" bindchange="onA" block-size="18" />
    <view class="lab3d-row">
      <text class="lab3d-label">匝数 N</text>
      <text class="lab3d-val">{{nVal}}</text>
    </view>
    <slider min="1" max="8" step="1" value="{{nSlider}}" bindchange="onTurns" block-size="18" />
    <view class="lab3d-row">
      <text class="lab3d-label">损耗电阻</text>
      <text class="lab3d-val">{{lossVal}}</text>
    </view>
    <slider min="2" max="500" step="2" value="{{lossSlider}}" bindchange="onLoss" block-size="18" />
  </view>

  <!-- 读数 -->
  <view class="lab3d-stats pop">
    <view class="kicker lab3d-stats-title">读数</view>
    <view class="lab3d-stats-grid">
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{rr}}</view>
        <view class="lab3d-stat-name">辐射电阻</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{eta}}</view>
        <view class="lab3d-stat-name">估计效率</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">{{area}}</view>
        <view class="lab3d-stat-name">NA/λ²</view>
      </view>
      <view class="lab3d-stat">
        <view class="lab3d-stat-value num">sin²θ</view>
        <view class="lab3d-stat-name">功率方向图</view>
      </view>
    </view>
  </view>

  <!-- 2D 方向图 -->
  <view class="lab3d-section rise">
    <view class="kicker">方向图截面</view>
    <canvas type="2d" id="plot" class="lab3d-2d"></canvas>
  </view>

  <view class="lab3d-note rise">
    <view class="kicker">原理</view>
    <view class="lab3d-note-item">小环等效为磁偶极子，环轴方向为零点、环面内辐射最大</view>
    <view class="lab3d-note-item">尺寸很小时，辐射电阻随面积平方下降</view>
    <view class="lab3d-note-item">黄色 = 环形电流 · 蓝线 = 近区磁场 · 白色甜甜圈 = sin²θ 方向图</view>
  </view>

</view>

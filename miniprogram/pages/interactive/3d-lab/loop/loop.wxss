/* pages/interactive/3d-lab/loop/loop.wxss —— 小环天线 */
.lab3d { padding-top: 20rpx; }

.lab3d-head { padding: 20rpx 12rpx 24rpx; }
.lab3d-title { font-size: 44rpx; margin: 8rpx 0 4rpx; }
.lab3d-sub { font-size: 24rpx; color: var(--muted); }

/* ── Canvas ── */
.lab3d-canvas-wrap {
  margin: 0 12rpx 20rpx;
  background: #3a3d48;
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
  position: relative;
  overflow: hidden;
}
.lab3d-canvas {
  width: 686rpx;
  height: 600rpx;
  display: block;
}
.lab3d-hint {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: rgba(255,255,255,.5);
  white-space: nowrap;
}

/* ── 通用 section ── */
.lab3d-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.lab3d-section .kicker { margin-bottom: 16rpx; }

/* ── 参数行 ── */
.lab3d-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 4rpx;
}
.lab3d-label { font-size: 26rpx; color: var(--muted); }
.lab3d-val { font-size: 26rpx; color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }

/* ── 2D 画布 ── */
.lab3d-2d {
  width: 630rpx;
  height: 280rpx;
  display: block;
  margin: 0 auto;
}

/* ── 统计 ── */
.lab3d-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.lab3d-stats-title { margin-bottom: 16rpx; }
.lab3d-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.lab3d-stat {
  background: var(--bg-soft);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
}
.lab3d-stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.lab3d-stat-name {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* ── 提示 ── */
.lab3d-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.lab3d-note .kicker { margin-bottom: 12rpx; }
.lab3d-note-item {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}

/* pages/interactive/3d-lab/loop/loop.wxss —— 小环天线 */
.lab3d { padding-top: 20rpx; }

.lab3d-head { padding: 20rpx 12rpx 24rpx; }
.lab3d-title { font-size: 44rpx; margin: 8rpx 0 4rpx; }
.lab3d-sub { font-size: 24rpx; color: var(--muted); }

/* ── Canvas ── */
.lab3d-canvas-wrap {
  margin: 0 12rpx 20rpx;
  background: #2a2e3a;
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
  position: relative;
  overflow: hidden;
}
.lab3d-canvas {
  width: 686rpx;
  height: 600rpx;
  display: block;
}
.lab3d-hint {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: rgba(255,255,255,.5);
  white-space: nowrap;
}

/* ── 通用 section ── */
.lab3d-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.lab3d-section .kicker { margin-bottom: 16rpx; }

/* ── 参数行 ── */
.lab3d-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 4rpx;
}
.lab3d-label { font-size: 26rpx; color: var(--muted); }
.lab3d-val { font-size: 26rpx; color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }

/* ── 2D 画布 ── */
.lab3d-2d {
  width: 630rpx;
  height: 280rpx;
  display: block;
  margin: 0 auto;
}

/* ── 统计 ── */
.lab3d-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.lab3d-stats-title { margin-bottom: 16rpx; }
.lab3d-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.lab3d-stat {
  background: var(--bg-soft);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
}
.lab3d-stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.lab3d-stat-name {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* ── 提示 ── */
.lab3d-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.lab3d-note .kicker { margin-bottom: 12rpx; }
.lab3d-note-item {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}

/* ════════════════════════════════════════
   深空暖金实验室 · 公共舞台样式（全部 3D 页共享）
   ════════════════════════════════════════ */
.lab3d-canvas-wrap {
  background: linear-gradient(168deg, #454b63 0%, #262b3c 52%, #161a26 100%);
  border: 1rpx solid rgba(212, 173, 126, 0.14);
  box-shadow: 0 8rpx 32rpx rgba(22, 26, 38, 0.35);
}

/* 手势提示：2.4s 后淡出 */
.lab3d-hint { transition: opacity 0.6s ease; }
.lab3d-hint.fade { opacity: 0; }

/* WebGL 初始化骨架屏 */
.lab3d-skel {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: linear-gradient(168deg, #454b63 0%, #262b3c 52%, #161a26 100%);
  z-index: 2;
}
.lab3d-skel-ring {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(212, 173, 126, 0.25);
  border-top-color: rgba(212, 173, 126, 0.9);
  animation: lab3d-spin 0.9s linear infinite;
}
@keyframes lab3d-spin {
  to { transform: rotate(360deg); }
}
.lab3d-skel-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 3rpx;
}

/* 无障碍：减弱动画时骨架环静止、提示不淡出 */
@media (prefers-reduced-motion: reduce) {
  .lab3d-skel-ring { animation: none; }
  .lab3d-hint { transition: none; }
}

/* pages/interactive/3d-lab/loop/loop.wxss —— 小环天线
   公共舞台样式已迁至 ../lab3d.wxss（内含 tool-ui.wxss），此处只留页面特有样式。 */
@import "../lab3d.wxss";

/* 超出电小环模型适用范围的醒目警告 */
.loop-warn {
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b3403a;
  background: rgba(179, 64, 58, 0.08);
  border: 1rpx solid rgba(179, 64, 58, 0.25);
  border-radius: 12rpx;
}

<!-- pages/interactive/3d-lab/horn/horn.wxml —— 喇叭天线 3D -->
<view class="screen lab3d">

  <view class="lab3d-head rise">
    <view class="kicker">3D HORN APERTURE · PHASE ERROR MAP</view>
    <view class="lab3d-title display">喇叭天线</view>
    <view class="lab3d-sub">口径尺寸 · 张角 · 相位误差 · E/H 面方向图</view>
  </view>

  <view class="lab3d-canvas-wrap rise">
    <canvas type="webgl" id="three-canvas" class="lab3d-canvas"
      catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"></canvas>
    <view wx:if="{{!glReady}}" class="lab3d-skel">
      <view class="lab3d-skel-ring"></view>
      <text class="lab3d-skel-text">正在初始化 3D 场景…</text>
    </view>
    <view class="lab3d-hint {{showHint ? '' : 'fade'}}">单指旋转 · 双指缩放 · 双击复位</view>
  </view>

  <view class="lab3d-section rise">
    <view class="kicker">几何尺寸</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">口径 A/λ</text>
      <slider class="tp-slider" min="20" max="160" step="2" value="{{aSlider}}" bindchanging="onAChanging" bindchange="onA" />
      <text class="tp-slider-val">{{aVal}}</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">轴向长度 R/λ</text>
      <slider class="tp-slider" min="20" max="240" step="2" value="{{lSlider}}" bindchanging="onRChanging" bindchange="onR" />
      <text class="tp-slider-val">{{lVal}}</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">照明边缘电平</text>
      <slider class="tp-slider" min="0" max="24" step="1" value="{{tapSlider}}" bindchanging="onTapChanging" bindchange="onTap" />
      <text class="tp-slider-val">{{tapVal}}</text>
    </view>
  </view>

  <view class="lab3d-stats pop">
    <view class="kicker lab3d-stats-title">读数</view>
    <view class="lab3d-stats-grid">
      <view class="lab3d-stat"><view class="lab3d-stat-value num tp-c-gold">{{phase}}</view><view class="lab3d-stat-name">边缘相位误差 δmax</view></view>
      <view class="lab3d-stat"><view class="lab3d-stat-value num tp-c-accent">{{gain}}</view><view class="lab3d-stat-name">增益（口径积分 η）</view></view>
      <view class="lab3d-stat"><view class="lab3d-stat-value num">{{flare}}</view><view class="lab3d-stat-name">半张角 ψ</view></view>
      <view class="lab3d-stat"><view class="lab3d-stat-value num tp-c-teal">{{hpbw}}</view><view class="lab3d-stat-name">HPBW E/H（数值 −3 dB）</view></view>
    </view>
  </view>

  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">E / H 面方向图 · 各自归一化（dB）</view>
    <canvas type="2d" id="plot" class="tp-canvas-short"></canvas>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式</view>
    <view class="tp-formula-line">Δ = √(R²+(A/2)²) − R　·　δmax = 2πΔ/λ　·　ψ = atan(A/2R)</view>
    <view class="tp-formula-line">F(θ) = (1+cosθ)/2 · |∫₋₁¹ g(u)·e^(j[πA·u·sinθ/λ − δmax·u²]) du|</view>
    <view class="tp-formula-line">g_E = 1　·　g_H = p+(1−p)cos(πu/2)，p = 10^(−边缘电平/20)　·　G = 10lg(4π·ηE·ηH·(A/λ)²)</view>
    <view class="tp-formula-cond">适用条件：方口径 A×A、两面同轴长 R 的教学模型；η 与方向图出自同一二次相位（Fresnel 型）口径积分，HPBW 直接取数值方向图 −3 dB 点，读数与曲线自洽；未计边缘绕射与法兰反射。校验点：δ=0 时 ηE=1、纯余弦 ηH=8/π²，H 面首旁瓣约 −23 dB。</view>
  </view>

  <view class="lab3d-note rise">
    <view class="kicker">原理</view>
    <view class="lab3d-note-item">口径越大理想增益越高；但喇叭太短时边缘路径变长，二次相位误差抹平主瓣、填平零点</view>
    <view class="lab3d-note-item">边缘电平越低（锥削越深），H 面旁瓣越低，代价是口径效率与增益略降</view>
    <view class="lab3d-note-item">赭金 = 喇叭壁 · 口径色面 = 相位滞后（浅→深对应 0°→360°，固定标尺）· 赤陶框 = 口径边缘</view>
  </view>

</view>

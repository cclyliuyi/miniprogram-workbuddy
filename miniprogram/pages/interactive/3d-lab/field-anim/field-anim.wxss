/* 电偶极子辐射动画 — 共享 3D 实验室样式（lab3d.wxss 内已 @import tool-ui.wxss） */
@import "../lab3d.wxss";

/* 2D 标注层：覆盖在 WebGL 画布上（场区圈 / 比例尺 / 色标），不接收触摸 */
.fa-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 686rpx;
  height: 600rpx;
  pointer-events: none;
}

/* 场区图例（点色与画面边界圈同源：赤陶/赭金/青绿） */
.fa-zone {
  display: flex; align-items: flex-start; gap: 16rpx; margin: 12rpx 0;
}
.fa-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; margin-top: 6rpx; }
.fa-c-accent { background: #b85c38; }
.fa-c-gold { background: #b07d1e; }
.fa-c-teal { background: #1f8a70; }
.fa-zone-text { font-size: 26rpx; color: var(--ink); }
.fa-zone-val { font-size: 22rpx; color: var(--muted); margin-top: 2rpx; font-family: monospace; }

/* pages/interactive/boundary-mode-lab/boundary-mode-lab.wxss —— 边界模式 */
.bm { padding-top: 20rpx; }

.bm-head { padding: 20rpx 12rpx 24rpx; }
.bm-title { font-size: 40rpx; margin: 8rpx 0 4rpx; }
.bm-sub { font-size: 24rpx; color: var(--muted); }

.bm-canvas-wrap {
  margin: 0 12rpx 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.bm-canvas-sq { width: 600rpx; height: 480rpx; margin: 0 auto; display: block; }
.bm-sub-plot {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.bm-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.bm-section .kicker { margin-bottom: 16rpx; }

.bm-btns {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.bm-btn {
  flex: 1;
  min-width: 130rpx;
  text-align: center;
  padding: 14rpx 6rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.bm-btn.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.bm-slider-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.bm-slider-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  width: 180rpx;
  flex-shrink: 0;
}
.bm-slider { flex: 1; margin: 0 12rpx; }

.bm-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.bm-note-text {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}

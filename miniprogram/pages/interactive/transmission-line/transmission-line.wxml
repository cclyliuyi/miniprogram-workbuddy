<!-- pages/interactive/transmission-line/transmission-line.wxml —— 传输线驻波 -->
<view class="screen tl">

  <view class="tl-head rise">
    <view class="kicker">TRANSMISSION LINE</view>
    <view class="tl-title display">传输线驻波</view>
    <view class="tl-sub">V(z) 电压分布 · Γ / SWR / Z_in 实时求解</view>
  </view>

  <!-- V(z) 和 I(z) 分布 -->
  <view class="tl-canvas-wrap rise">
    <view class="tl-sub-plot">|V(z)| 电压驻波</view>
    <canvas type="2d" id="vCanvas" class="tl-canvas-wide"></canvas>
  </view>

  <view class="tl-canvas-wrap rise">
    <view class="tl-sub-plot">|I(z)| 电流驻波</view>
    <canvas type="2d" id="iCanvas" class="tl-canvas-wide"></canvas>
  </view>

  <!-- 负载类型 -->
  <view class="tl-section rise">
    <view class="kicker">负载类型</view>
    <view class="tl-load-btns">
      <view class="tl-load {{S.loadType==='short' ? 'active' : ''}}" bindtap="setShort">短路</view>
      <view class="tl-load {{S.loadType==='open' ? 'active' : ''}}" bindtap="setOpen">开路</view>
      <view class="tl-load {{S.loadType==='match' ? 'active' : ''}}" bindtap="setMatch">匹配</view>
      <view class="tl-load {{S.loadType==='custom' ? 'active' : ''}}" bindtap="setCustom">自定义</view>
    </view>
  </view>

  <!-- 参数 -->
  <view class="tl-section rise">
    <view class="kicker">传输线参数</view>

    <view class="tl-slider-row">
      <text class="tl-slider-label">特性阻抗 Z₀</text>
      <slider class="tl-slider" min="10" max="200" step="5" value="{{S.Z0}}"
        bindchange="onZ0" show-value />
      <text class="tl-slider-unit">Ω</text>
    </view>

    <view class="tl-slider-row">
      <text class="tl-slider-label">线长 (λ)</text>
      <slider class="tl-slider" min="0.1" max="2" step="0.05" value="{{S.length}}"
        bindchange="onLength" show-value />
    </view>

    <!-- 自定义负载 -->
    <block wx:if="{{S.loadType === 'custom'}}">
      <view class="tl-field-row">
        <view class="tl-field-half">
          <text class="tl-label">负载电阻 R_L</text>
          <input class="tl-input num" type="digit" value="{{S.ZLr}}" bindinput="onZLr" />
          <text class="tl-hint">Ω</text>
        </view>
        <view class="tl-field-half">
          <text class="tl-label">负载电抗 X_L</text>
          <input class="tl-input num" type="digit" value="{{S.ZLi}}" bindinput="onZLi" />
          <text class="tl-hint">Ω（正=感性）</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 实时读数 -->
  <view class="tl-readout pop" wx:if="{{readout}}">
    <view class="kicker tl-readout-title">关键参数</view>
    <view class="tl-readout-grid">
      <view class="tl-rc">
        <view class="tl-rc-label">|Γ|</view>
        <view class="tl-rc-value num">{{readout.gamma}}</view>
      </view>
      <view class="tl-rc">
        <view class="tl-rc-label">∠Γ</view>
        <view class="tl-rc-value num">{{readout.gammaDeg}}°</view>
      </view>
      <view class="tl-rc">
        <view class="tl-rc-label">SWR</view>
        <view class="tl-rc-value num tl-highlight">{{readout.swr}}</view>
      </view>
      <view class="tl-rc">
        <view class="tl-rc-label">Z_in (源端)</view>
        <view class="tl-rc-value num">{{readout.zIn}}</view>
      </view>
      <view class="tl-rc">
        <view class="tl-rc-label">V_max</view>
        <view class="tl-rc-value num">{{readout.vMax}}</view>
      </view>
      <view class="tl-rc">
        <view class="tl-rc-label">V_min</view>
        <view class="tl-rc-value num">{{readout.vMin}}</view>
      </view>
    </view>
    <view class="tl-load-info">
      负载阻抗 Z_L = <text class="num">{{readout.zLreal}}</text> + j<text class="num">{{readout.zLimag}}</text> Ω
    </view>
  </view>

  <!-- 公式说明 -->
  <view class="tl-formula-note rise">
    <view class="kicker">传输线方程</view>
    <view class="tl-formula-item">Γ_L = (Z_L − Z₀) / (Z_L + Z₀)</view>
    <view class="tl-formula-item">V(z) = V⁺(e^{-jβz} + Γ_L·e^{jβz})</view>
    <view class="tl-formula-item">SWR = (1 + |Γ|) / (1 − |Γ|)</view>
    <view class="tl-formula-item">Z_in = Z₀ · (Z_L + jZ₀tanβl) / (Z₀ + jZ_L tanβl)</view>
    <view class="tl-formula-item">β = 2π/λ</view>
  </view>

</view>

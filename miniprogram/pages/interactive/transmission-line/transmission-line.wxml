<!-- pages/interactive/transmission-line/transmission-line.wxml —— 传输线驻波 -->
<view class="screen tp-page">

  <view class="tp-head rise">
    <view class="kicker">TRANSMISSION LINE</view>
    <view class="tp-title display">传输线驻波</view>
    <view class="tp-sub">|V(d)|、|I(d)| 驻波分布 · Γ / SWR / Z_in 实时求解</view>
  </view>

  <!-- 驻波分布（V/I 同轴叠画，波腹波节互补一目了然） -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">电压 / 电流驻波（同轴叠画：V 的波腹正是 I 的波节）</view>
    <canvas type="2d" id="waveCanvas" class="tp-canvas"></canvas>
  </view>

  <!-- 负载类型 -->
  <view class="tp-section rise">
    <view class="kicker">负载类型</view>
    <view class="tp-btns">
      <view class="tp-btn {{S.loadType==='short' ? 'active' : ''}}" bindtap="setShort">短路</view>
      <view class="tp-btn {{S.loadType==='open' ? 'active' : ''}}" bindtap="setOpen">开路</view>
      <view class="tp-btn {{S.loadType==='match' ? 'active' : ''}}" bindtap="setMatch">匹配</view>
      <view class="tp-btn {{S.loadType==='custom' ? 'active' : ''}}" bindtap="setCustom">自定义</view>
    </view>
  </view>

  <!-- 参数 -->
  <view class="tp-section rise">
    <view class="kicker">传输线参数</view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">特性阻抗 Z₀</text>
      <slider class="tp-slider" min="10" max="200" step="5" value="{{S.Z0}}"
        bindchanging="onZ0" bindchange="onZ0" />
      <text class="tp-slider-val">{{S.Z0}} Ω</text>
    </view>
    <view class="tp-slider-row">
      <text class="tp-slider-label">线长 l</text>
      <slider class="tp-slider" min="0.1" max="2" step="0.05" value="{{S.length}}"
        bindchanging="onLength" bindchange="onLength" />
      <text class="tp-slider-val">{{S.length}} λ</text>
    </view>

    <!-- 自定义负载（X_L 用 text 键盘，可输入负号 = 容性） -->
    <block wx:if="{{S.loadType === 'custom'}}">
      <view class="tp-input-row">
        <text class="tp-input-label">负载电阻 R_L (Ω)</text>
        <input class="tp-input num" type="digit" value="{{S.ZLr}}" bindinput="onZLr" />
      </view>
      <view class="tp-input-row">
        <text class="tp-input-label">负载电抗 X_L (Ω)</text>
        <input class="tp-input num" type="text" value="{{S.ZLi}}" bindinput="onZLi" />
      </view>
      <view class="tl-hint">X_L 正 = 感性，负 = 容性（如 −25 表示容性负载）</view>
    </block>
  </view>

  <!-- 实时读数 -->
  <view class="tp-section pop" wx:if="{{readout}}">
    <view class="kicker">关键参数</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">反射系数 |Γ| ∠Γ</view>
        <view class="tp-stat-value">{{readout.gamma}} ∠{{readout.gammaDeg}}°</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">驻波比 SWR</view>
        <view class="tp-stat-value tp-c-accent">{{readout.swr}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">源端输入阻抗 Z_in</view>
        <view class="tp-stat-value tp-c-indigo">{{readout.zIn}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">V_max / V_min（|V⁺|=1 归一）</view>
        <view class="tp-stat-value">{{readout.vMax}} / {{readout.vMin}}</view>
      </view>
      <view class="tp-stat tp-stat-wide">
        <view class="tp-stat-label">首个波腹 d_max / 波节 d_min（离负载）</view>
        <view class="tp-stat-value tp-c-gold">{{readout.dPos}}</view>
      </view>
      <view class="tp-stat tp-stat-wide">
        <view class="tp-stat-label">负载阻抗 Z_L</view>
        <view class="tp-stat-value tp-c-teal">{{readout.zL}}</view>
      </view>
    </view>
    <view class="tl-quarter" wx:if="{{readout.quarter}}">
      ★ 当前线长为 λ/4 的奇数倍：Z_in = Z₀²/Z_L —— λ/4 变换器把阻抗"翻转"（短路 ↔ 开路）。
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式</view>
    <view class="tp-formula-line">Γ_L = (Z_L − Z₀)/(Z_L + Z₀)　·　SWR = (1 + |Γ|)/(1 − |Γ|)</view>
    <view class="tp-formula-line">|V(d)| = |1 + Γe^(−j2βd)|　·　|I(d)| = |1 − Γe^(−j2βd)|　·　β = 2π/λ</view>
    <view class="tp-formula-line">Z_in = Z₀(Z_L + jZ₀tanβl)/(Z₀ + jZ_L tanβl)　·　d_max = λ·∠Γ/4π (mod λ/2)</view>
    <view class="tp-formula-cond">适用条件：无耗均匀传输线、单频稳态、TEM 传播；幅度以入射波 |V⁺| = 1 归一（|I| 同时以 |V⁺|/Z₀ 归一）；d 自负载向源度量。</view>
  </view>

</view>

/* pages/interactive/transmission-line/transmission-line.wxss —— 传输线驻波
   共享 UI 见 styles/tool-ui.wxss（tp-* 类），本文件只放页面特有样式。 */
@import "../../../styles/tool-ui.wxss";

/* 自定义负载输入提示 */
.tl-hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* λ/4 变换器观察引导 */
.tl-quarter {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b07d1e;
  background: rgba(176, 125, 30, 0.08);
  border-radius: 12rpx;
}

/* pages/interactive/miniaturization/miniaturization.wxss —— 电小天线 */
.mc { padding-top: 20rpx; }

.mc-head { padding: 20rpx 12rpx 24rpx; }
.mc-title { font-size: 40rpx; margin: 8rpx 0 4rpx; }
.mc-sub { font-size: 24rpx; color: var(--muted); }

.mc-canvas-wrap {
  margin: 0 12rpx 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.mc-canvas { width: 686rpx; height: 440rpx; }
.mc-sub-plot {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.mc-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.mc-section .kicker { margin-bottom: 16rpx; }

.mc-btns {
  display: flex;
  gap: 12rpx;
}
.mc-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.mc-btn.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.mc-slider-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.mc-slider-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  width: 200rpx;
  flex-shrink: 0;
}
.mc-slider { flex: 1; margin: 0 12rpx; }

.mc-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.mc-stats-title { margin-bottom: 16rpx; }
.mc-stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.mc-stat {
  width: calc(50% - 6rpx);
  padding: 18rpx 20rpx;
  background: var(--paper);
  border-radius: 14rpx;
}
.mc-stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.mc-stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.mc-formula-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.mc-formula-item {
  font-size: 22rpx;
  color: var(--muted);
  font-family: 'SF Mono', 'Menlo', monospace;
  padding: 6rpx 0;
  letter-spacing: .5rpx;
}

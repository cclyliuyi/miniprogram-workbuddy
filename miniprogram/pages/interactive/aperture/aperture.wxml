<!-- pages/interactive/aperture/aperture.wxml —— 口径场与波束宽度 -->
<view class="screen tp-page">

  <view class="tp-head rise">
    <view class="kicker">APERTURE RADIATION</view>
    <view class="tp-title display">口径衍射</view>
    <view class="tp-sub">矩形/圆形口径 · 照明分布 → 远场方向图</view>
  </view>

  <!-- 远场方向图 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">远场方向图 AF(θ) · {{S.shape === 'circ' ? '圆口径径向积分' : '矩形口径（一维线源）'}}</view>
    <canvas type="2d" id="patternCanvas" class="tp-canvas"></canvas>
  </view>

  <!-- 口径照明分布 -->
  <view class="tp-canvas-card rise">
    <view class="tp-canvas-caption">口径照明分布 · {{illumName}} {{S.shape === 'circ' ? 'E(ρ)' : 'E(x)'}}</view>
    <canvas type="2d" id="illumCanvas" class="tp-canvas-short"></canvas>
  </view>

  <!-- 参数 -->
  <view class="tp-section rise">
    <view class="kicker">口径参数</view>

    <view class="tp-btns ap-btns-gap">
      <view class="tp-btn {{S.shape==='rect' ? 'active' : ''}}" data-s="rect" bindtap="setShape">矩形口径</view>
      <view class="tp-btn {{S.shape==='circ' ? 'active' : ''}}" data-s="circ" bindtap="setShape">圆形口径</view>
    </view>

    <view class="tp-slider-row">
      <text class="tp-slider-label">口径尺寸 D</text>
      <slider class="tp-slider" min="1" max="20" step="0.5" value="{{S.D}}"
        bindchanging="onD" bindchange="onD" />
      <text class="tp-slider-val">{{S.D}} λ</text>
    </view>

    <view class="tp-slider-row {{S.illum !== 'tapered' ? 'ap-row-dim' : ''}}">
      <text class="tp-slider-label">边缘锥削</text>
      <slider class="tp-slider" min="-40" max="0" step="1" value="{{S.tap}}"
        disabled="{{S.illum !== 'tapered'}}"
        bindchanging="onTap" bindchange="onTap" />
      <text class="tp-slider-val">{{S.illum === 'tapered' ? S.tap + ' dB' : '—'}}</text>
    </view>
    <view class="ap-hint" wx:if="{{S.illum !== 'tapered'}}">边缘锥削仅在“抛物线锥削”照明下生效</view>
  </view>

  <!-- 照明分布选择 -->
  <view class="tp-section rise">
    <view class="kicker">照明分布类型</view>
    <view class="tp-btns">
      <view class="tp-btn {{S.illum==='uniform' ? 'active' : ''}}" data-i="uniform" bindtap="setIllum">均匀</view>
      <view class="tp-btn {{S.illum==='cosine' ? 'active' : ''}}" data-i="cosine" bindtap="setIllum">余弦</view>
      <view class="tp-btn {{S.illum==='tapered' ? 'active' : ''}}" data-i="tapered" bindtap="setIllum">抛物线锥削</view>
    </view>
  </view>

  <!-- 读数 -->
  <view class="tp-section pop" wx:if="{{stats}}">
    <view class="kicker">方向图参数</view>
    <view class="tp-stats-grid">
      <view class="tp-stat">
        <view class="tp-stat-label">半功率波束宽 HPBW</view>
        <view class="tp-stat-value tp-c-indigo">{{stats.hpbw}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">最大旁瓣电平 SLL</view>
        <view class="tp-stat-value tp-c-gold">{{stats.sll}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">口径（锥削）效率 η</view>
        <view class="tp-stat-value tp-c-teal">{{stats.efficiency}}</view>
      </view>
      <view class="tp-stat">
        <view class="tp-stat-label">{{stats.dirLabel}}</view>
        <view class="tp-stat-value tp-c-accent">{{stats.directivity}}</view>
      </view>
    </view>
  </view>

  <!-- 公式注脚 -->
  <view class="tp-formula rise">
    <view class="tp-formula-title">所用公式（{{S.shape === 'circ' ? '圆形口径' : '矩形口径'}}）</view>
    <block wx:if="{{S.shape === 'rect'}}">
      <view class="tp-formula-line">AF(θ) = ∫₋₁¹ E(x)·e^(jπ(D/λ)x·sinθ) dx，x = 2x′/D</view>
      <view class="tp-formula-line">均匀照明：AF ∝ sinc(πD sinθ/λ)，HPBW ≈ 0.886 λ/D rad，SLL ≈ −13.26 dB</view>
      <view class="tp-formula-line">η = (∫E dx)² / (L·∫E² dx)　·　D₀ = (2L/λ)·η</view>
    </block>
    <block wx:else>
      <view class="tp-formula-line">AF(θ) = ∫₀¹ E(ρ)·J₀(π(D/λ)ρ·sinθ)·ρ dρ，ρ = 2r/D</view>
      <view class="tp-formula-line">均匀照明：AF ∝ 2J₁(u)/u（Airy），HPBW ≈ 1.028 λ/D rad，SLL ≈ −17.57 dB</view>
      <view class="tp-formula-line">η = 2(∫Eρ dρ)² / ∫E²ρ dρ　·　D₀ = (πD/λ)²·η</view>
    </block>
    <view class="tp-formula-cond">适用条件：标量口径场 + Fraunhofer 远场近似（r &gt; 2D²/λ）；矩形口径按一维线源建模（单切面），其指向性为线源公式 2L/λ·η，与二维实口径增益不可直接比较；HPBW 近似式中 λ/D 为弧度。</view>
  </view>

  <!-- 说明 -->
  <view class="tp-note rise">
    <view class="kicker">锥削三角权衡</view>
    <view class="tp-note-text">照明越向边缘收窄（锥削越深），旁瓣越低，但主瓣变宽、口径效率下降——均匀照明 η = 100% 但 SLL 最高；余弦照明 η ≈ 81%，矩形口径旁瓣降到约 −23 dB。图上 −3 dB 虚线与两枚圆点即半功率波束宽的读取位置。</view>
  </view>

</view>

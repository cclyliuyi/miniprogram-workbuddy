<!-- pages/interactive/fourier-space-lab/fourier-space-lab.wxml —— 傅里叶空间 -->
<view class="screen fs">

  <view class="fs-head rise">
    <view class="kicker">FOURIER SPACE LAB</view>
    <view class="fs-title display">傅里叶空间</view>
    <view class="fs-sub">同一个傅里叶结构 · 四种课程视角</view>
  </view>

  <!-- 左画布：分布 -->
  <view class="fs-canvas-wrap rise">
    <view class="fs-sub-plot">{{leftLabel}}</view>
    <canvas type="2d" id="leftCanvas" class="fs-canvas"></canvas>
  </view>

  <!-- 右画布：谱 -->
  <view class="fs-canvas-wrap rise">
    <view class="fs-sub-plot">{{rightLabel}}</view>
    <canvas type="2d" id="rightCanvas" class="fs-canvas"></canvas>
  </view>

  <!-- 模式切换 -->
  <view class="fs-section rise">
    <view class="kicker">实验模式</view>
    <view class="fs-btns">
      <view class="fs-btn {{S.mode==='signal' ? 'active' : ''}}" bindtap="setSignal">时间信号</view>
      <view class="fs-btn {{S.mode==='aperture' ? 'active' : ''}}" bindtap="setAperture">口径天线</view>
      <view class="fs-btn {{S.mode==='array' ? 'active' : ''}}" bindtap="setArray">阵列采样</view>
      <view class="fs-btn {{S.mode==='uncertainty' ? 'active' : ''}}" bindtap="setUncertainty">不确定性</view>
    </view>
  </view>

  <!-- 参数 -->
  <view class="fs-section rise">
    <view class="kicker">参数</view>
    <view class="fs-slider-row">
      <text class="fs-slider-label">分布宽度</text>
      <slider class="fs-slider" min="12" max="90" step="1" value="{{S.width}}"
        bindchange="onWidth" show-value />
    </view>
    <view class="fs-slider-row">
      <text class="fs-slider-label">采样间距</text>
      <slider class="fs-slider" min="25" max="120" step="1" value="{{S.spacing}}"
        bindchange="onSpacing" show-value />
    </view>
    <view class="fs-slider-row">
      <text class="fs-slider-label">边缘渐削</text>
      <slider class="fs-slider" min="0" max="100" step="1" value="{{S.taper}}"
        bindchange="onTaper" show-value />
    </view>
  </view>

  <!-- 观察结论 -->
  <view class="fs-note rise">
    <view class="kicker">观察结论</view>
    <view class="fs-note-item">宽窄互补：分布越宽，对偶谱越窄</view>
    <view class="fs-note-item">相位叠加：谱不是外形复制，是带相位的正弦/平面波叠加</view>
    <view class="fs-note-item">采样混叠：离散采样复制谱，重叠时出现栅瓣</view>
    <view class="fs-note-item">工程后果：更窄主瓣需更大口径、更长观测或更密采样</view>
  </view>

</view>

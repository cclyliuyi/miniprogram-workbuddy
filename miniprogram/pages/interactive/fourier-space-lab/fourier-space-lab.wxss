/* pages/interactive/fourier-space-lab/fourier-space-lab.wxss —— 傅里叶空间
   共享 UI 见 styles/tool-ui.wxss（tp-* 类），本文件只放页面特有覆盖。 */
@import "../../../styles/tool-ui.wxss";

/* 观察结论条目：随当前模式高亮 */
.fs-note-item {
  font-size: 23rpx;
  color: var(--muted);
  padding: 8rpx 12rpx;
  line-height: 1.6;
  border-radius: 10rpx;
  border-left: 4rpx solid transparent;
  transition: all 0.2s;
}
.fs-note-item.on {
  color: var(--ink-soft);
  background: rgba(184, 92, 56, 0.06);
  border-left-color: var(--accent);
}

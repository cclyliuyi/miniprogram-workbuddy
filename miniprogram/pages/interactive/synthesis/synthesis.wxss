/* pages/interactive/synthesis/synthesis.wxss —— 方向图综合 */
.sy { padding-top: 20rpx; }

.sy-head { padding: 20rpx 12rpx 24rpx; }
.sy-title { font-size: 44rpx; margin: 8rpx 0 4rpx; }
.sy-sub { font-size: 24rpx; color: var(--muted); }

.sy-canvas-wrap {
  margin: 0 12rpx 20rpx;
  padding: 16rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.05);
}
.sy-canvas-wide { width: 686rpx; height: 400rpx; }
.sy-sub-plot {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}

.sy-section {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.sy-section .kicker { margin-bottom: 16rpx; }

.sy-slider-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.sy-slider-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  width: 180rpx;
  flex-shrink: 0;
}
.sy-slider { flex: 1; margin: 0 12rpx; }
.sy-slider-unit {
  font-size: 22rpx;
  color: var(--muted);
  width: 56rpx;
  text-align: right;
  flex-shrink: 0;
}

.sy-weight-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sy-w {
  flex: 1;
  min-width: calc(25% - 9rpx);
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--paper);
  border: 1rpx solid var(--line-soft);
  border-radius: 14rpx;
  transition: all .2s;
}
.sy-w.active {
  color: var(--accent);
  border-color: var(--accent);
  background: rgba(176,106,79,.06);
  font-weight: 600;
}

.sy-stats {
  margin: 0 12rpx 20rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 16rpx rgba(32,32,28,.04);
}
.sy-stats-title { margin-bottom: 16rpx; }
.sy-stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sy-stat {
  width: calc(25% - 9rpx);
  padding: 18rpx 12rpx;
  background: var(--paper);
  border-radius: 14rpx;
  text-align: center;
}
.sy-stat-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.sy-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.sy-formula-note {
  margin: 0 12rpx 40rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
}
.sy-formula-item {
  font-size: 22rpx;
  color: var(--muted);
  font-family: 'SF Mono', 'Menlo', monospace;
  padding: 6rpx 0;
  letter-spacing: .5rpx;
}

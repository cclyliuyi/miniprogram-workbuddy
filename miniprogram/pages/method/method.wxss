page { background:#f3efe6; }
.learning-list { padding:42rpx 32rpx 130rpx; }
.series-header { margin-bottom:58rpx; }
.series-eyebrow { font-size:26rpx; color:#68786f; margin-bottom:14rpx; }
.series-title { font-size:56rpx; font-weight:600; color:#102d45; line-height:1.3; }
.series-intro { margin-top:24rpx; color:#655f54; font-size:30rpx; line-height:1.8; }
.stage { margin-bottom:54rpx; }
.stage-heading { display:flex; gap:18rpx; align-items:baseline; font-size:36rpx; font-weight:600; color:#173c4a; }
.stage-number { color:#af7451; font-size:30rpx; font-weight:400; }
.stage-description { font-size:27rpx; color:#746b5f; margin:12rpx 0 24rpx; line-height:1.7; }
.lesson-card { display:flex; gap:24rpx; padding:18rpx; background:#fcfaf5; border:1rpx solid #e8e0d1; border-radius:20rpx; margin-bottom:18rpx; }
.lesson-pressed { opacity:.75; }
.lesson-thumbnail { width:190rpx; height:254rpx; flex-shrink:0; border-radius:10rpx; background:#f6f1e7; }
.lesson-summary { flex:1; min-width:0; padding:2rpx 8rpx 2rpx 0; }
.lesson-meta { display:flex; justify-content:space-between; color:#928676; font-size:24rpx; }
.read-label { color:#4e7664; }
.lesson-title { color:#163249; font-size:33rpx; font-weight:600; line-height:1.5; margin:10rpx 0; }
.lesson-subtitle { font-size:27rpx; color:#6e675c; line-height:1.65; }
.lesson-open { font-size:25rpx; color:#a36647; margin-top:14rpx; }
.series-footer { font-size:26rpx; color:#857b6c; text-align:center; line-height:1.8; padding:12rpx 18rpx; }

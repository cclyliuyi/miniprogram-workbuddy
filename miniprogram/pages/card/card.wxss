/* pages/card/card.wxss —— 日签卡（9:16 朋友圈竖版 · 手账风） */
.cd { padding-top: 24rpx; }

/* 预览区：9:16 竖版，居中 */
.cd-preview {
  width: 100%;
  aspect-ratio: 9 / 16;
  max-height: 70vh;
  margin: 0 auto;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(160deg, var(--paper-2), var(--paper));
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow);
}
.cd-img {
  width: 100%;
  height: 100%;
  display: block;
}
.cd-loading {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: var(--muted);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.cd-quote {
  font-size: 28rpx; line-height: 1.7; color: var(--ink-soft);
  text-align: center; margin: 28rpx 40rpx 32rpx;
  font-weight: 400;
}

.cd-actions { display: flex; justify-content: center; gap: 20rpx; }
.cd-actions .btn { min-width: 260rpx; }

/* 发送给朋友按钮 */
.cd-share-friend {
  min-width: 260rpx;
}

/* ═══ 朋友圈分享入口 ═══ */
.cd-moment {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 40rpx 0;
  padding: 22rpx 32rpx;
  background: var(--card);
  border-radius: 16rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 2rpx 12rpx rgba(32,32,28,.04);
  transition: transform .15s;
}
.cd-moment:active { transform: scale(.97); }
.cd-moment-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
/* 朋友圈图标（朋友圈=相机/朋友圈符号，用 CSS 圆环+点模拟） */
.cd-moment-ico {
  width: 40rpx; height: 40rpx;
  border: 3rpx solid var(--sage);
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.cd-moment-ico::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--sage);
}
.cd-moment-txt {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}
.cd-moment-arrow {
  font-size: 36rpx;
  color: var(--muted);
  line-height: 1;
}

/* ═══ 引导弹窗 ═══ */
.cd-guide {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(32,32,28,0.5);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cd-guide-fade 0.25s ease both;
}
@keyframes cd-guide-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
.cd-guide-card {
  width: 560rpx;
  padding: 48rpx 40rpx 36rpx;
  background: var(--card);
  border-radius: 28rpx;
  animation: cd-guide-pop 0.35s cubic-bezier(0.2,0.8,0.2,1) both;
}
@keyframes cd-guide-pop {
  0%   { opacity: 0; transform: scale(0.85); }
  100% { opacity: 1; transform: scale(1); }
}
.cd-guide-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.cd-guide-num {
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}
.cd-guide-text {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
  padding-top: 6rpx;
}
.cd-guide-dots {
  display: inline-block;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 2rpx;
}
.cd-guide-btn {
  width: 100%;
  margin-top: 8rpx;
}

/* 离屏画布尺寸同步 drawCard 逻辑像素 */
.cd-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 270px; height: 480px; }
